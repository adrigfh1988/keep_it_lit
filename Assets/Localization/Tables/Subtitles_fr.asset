--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Subtitles_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: b4c6f04b4f756474980167f6a0846058, type: 2}
  m_Metadata:
    m_Items:
    - rid: 4707331672703763194
  m_TableData:
  - m_Id: 341741568
    m_Localized: "\xC7a a l\xE2ch\xE9 prise. \xC7a ne recommencera pas."
    m_Metadata:
      m_Items: []
  - m_Id: 421433344
    m_Localized: Revenez en un seul morceau.
    m_Metadata:
      m_Items: []
  - m_Id: 421433345
    m_Localized: Comme vous voudrez.
    m_Metadata:
      m_Items: []
  - m_Id: 421433346
    m_Localized: "\xC7a a entendu."
    m_Metadata:
      m_Items: []
  - m_Id: 421433347
    m_Localized: Pas de pile de rechange.
    m_Metadata:
      m_Items: []
  - m_Id: 421433348
    m_Localized: Pas ici.
    m_Metadata:
      m_Items: []
  - m_Id: 421433349
    m_Localized: "La lampe est charg\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 421433350
    m_Localized: Pile neuve.
    m_Metadata:
      m_Items: []
  - m_Id: 421433351
    m_Localized: Pas de boussole stellaire.
    m_Metadata:
      m_Items: []
  - m_Id: 421433352
    m_Localized: "Plus rien \xE0 indiquer."
    m_Metadata:
      m_Items: []
  - m_Id: 421433353
    m_Localized: "LA TRAPPE EST D\xC9VERROUILL\xC9E"
    m_Metadata:
      m_Items: []
  - m_Id: 441658820694016
    m_Localized: LES PORTES DE SORTIE SONT SOUS TENSION
    m_Metadata:
      m_Items: []
  - m_Id: 7992965500928
    m_Localized: PILE
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387008
    m_Localized: + SECOND SOUFFLE
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387009
    m_Localized: "CL\xC9 {held} / {total}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 7993049387010
    m_Localized: +{amount} {currency}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 7993049387011
    m_Localized: "Quelque chose est attir\xE9 par la lumi\xE8re."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387012
    m_Localized: "Quelque part, un rideau se l\xE8ve."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387013
    m_Localized: 'CAM 3: MOUVEMENT'
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387014
    m_Localized: "IL A HURL\xC9."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387015
    m_Localized: "CONTRAT \xC9CHOU\xC9  -  {name}."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 7993049387016
    m_Localized: "CONTRAT R\xC9USSI  -  {name}."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 7993049387017
    m_Localized: "Rien ne brille ici - le contrat est annul\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387018
    m_Localized: "Pas de notes ici - le contrat est annul\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387019
    m_Localized: "March\xE9 conclu, march\xE9 tenu."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387020
    m_Localized: On ne peut pas toujours gagner.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387021
    m_Localized: "Des \xE9clats pour le noir. Qu'est-ce que ce sera?"
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387022
    m_Localized: Encore vous.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387023
    m_Localized: "Le bruit monte, l\xE0-haut."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387024
    m_Localized: "Dernier arr\xEAt avant le fond."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387028
    m_Localized: "Les lumi\xE8res s'\xE9teignent."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387030
    m_Localized: "\xC7a attendait."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387031
    m_Localized: "\xC9TAGE {floor}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 7993049387032
    m_Localized: "\xC9TAGE {floor} \u2014 {theme}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 7993049387033
    m_Localized: "TROUVER {n} \xC9TOILES"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 7993049387034
    m_Localized: "R\xC9TABLIR {n} FUSIBLES"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 7993049387035
    m_Localized: "TROUVER {n} CL\xC9S POUR LA TRAPPE"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 7993049387036
    m_Localized: "CONFINEMENT DE S\xC9CURIT\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387037
    m_Localized: "{name} \u2014 {description}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 41651860836352
    m_Localized: "\xC7A VOUS A ENTENDU."
    m_Metadata:
      m_Items: []
  - m_Id: 441658736807936
    m_Localized: "LES PORTES SONT D\xC9VERROUILL\xC9ES"
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972608
    m_Localized: "\xC7A SE SOUVIENT DES CASIERS."
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972609
    m_Localized: "\xC7A CONNA\xCET LES BOUTEILLES."
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972610
    m_Localized: "\xC7A A APPRIS L'OBSCURIT\xC9."
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972611
    m_Localized: "\xC7A VOUS ENTEND COURIR."
    m_Metadata:
      m_Items: []
  - m_Id: 113530231492608
    m_Localized: SI QUELQUE CHOSE CLOCHE, REVENEZ SUR VOS PAS. SINON, CONTINUEZ.
    m_Metadata:
      m_Items: []
  - m_Id: 113530315378688
    m_Localized: VOUS VOUS SOUVENEZ DU LABYRINTHE.
    m_Metadata:
      m_Items: []
  - m_Id: 113530315378689
    m_Localized: "\xC7A VOUS LAISSE PARTIR. UNE FOIS."
    m_Metadata:
      m_Items: []
  - m_Id: 390904076472320
    m_Localized: "REGARDEZ BIEN. C'EST AINSI QUE \xC7A DOIT \xCATRE."
    m_Metadata:
      m_Items: []
  - m_Id: 405333857964032
    m_Localized: "LE PLAN D'\xC9TAGE. SEULEMENT CE QUE VOUS AVEZ PARCOURU."
    m_Metadata:
      m_Items: []
  - m_Id: 441658820694017
    m_Localized: LA PORTE EST OUVERTE
    m_Metadata:
      m_Items: []
  - m_Id: 441658820694018
    m_Localized: "TROUVER {n} CL\xC9S POUR LES PORTES"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 791730481696768
    m_Localized: "UN CHEMIN \xC0 PART. RIEN NE VOUS Y OBLIGE. PASS\xC9 L'ANGLE, PLUS DE RETOUR."
    m_Metadata:
      m_Items: []
  - m_Id: 791730569777152
    m_Localized: "R\xC9USSISSEZ {n} FOIS DE SUITE : TOUT LE PLAN, UNE LAMPE PLEINE ET DES PROVISIONS."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 791730569777153
    m_Localized: LAMPE PLEINE
    m_Metadata:
      m_Items: []
  - m_Id: 1860893469569024
    m_Localized: "\xC7a t'a repouss\xE9. Ta lampe est par terre."
    m_Metadata:
      m_Items: []
  - m_Id: 1860893545066496
    m_Localized: "La prochaine fois, \xE7a ne l\xE2chera pas."
    m_Metadata:
      m_Items: []
  - m_Id: 1860893545066497
    m_Localized: "Tu as la lumi\xE8re."
    m_Metadata:
      m_Items: []
  - m_Id: 1860893545066498
    m_Localized: "\xC7A CONNA\xCET TA VOIX."
    m_Metadata:
      m_Items: []
  - m_Id: 1874627596382208
    m_Localized: SERMENT {rank}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 1879570495565824
    m_Localized: IL N'Y AVAIT PAS DE PORTE ICI.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565825
    m_Localized: "UNE PORTE DE PLUS QUE TOUT \xC0 L'HEURE."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565826
    m_Localized: LES TUYAUX FRAPPENT DEUX FOIS.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565827
    m_Localized: LES TUYAUX FRAPPENT TROIS FOIS.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565828
    m_Localized: VIDE. LE PLATEAU EST FROID.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565829
    m_Localized: "UNE \xC9TIQUETTE SANS NOM. PERSONNE SUR LE PLATEAU."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565830
    m_Localized: VIDE. QUELQU'UN L'A FAIT COMME UN LIT.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565831
    m_Localized: "TIROIR CINQ. SEULEMENT SON \xC9TIQUETTE, QUI ATTEND."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565832
    m_Localized: "L'\xC9TIQUETTE PORTE VOTRE NUM\xC9RO. LE PLATEAU EST ENCORE TI\xC8DE."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565833
    m_Localized: 'VOS AFFAIRES SONT SUR LE PLATEAU: UNE PILE DE RECHANGE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565834
    m_Localized: "VERRE CLAIR, CAPUCHON BLEU. VOTRE C\u0152UR RALENTIT."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565835
    m_Localized: LA PEUR SE TAIT. L'AVERTISSEMENT AUSSI.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565836
    m_Localized: LES TROIS. PERSONNE N'A UNE DOSE TROP COURTE.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565837
    m_Localized: "VOTRE C\u0152UR EST DE RETOUR."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565838
    m_Localized: "BONSOIR. LE R\xC8GLEMENT INT\xC9RIEUR EST AFFICH\xC9. MERCI."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565839
    m_Localized: "PATIENT {mark}. AU PAS, S'IL VOUS PLA\xCET."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 1879570495565840
    m_Localized: "PATIENT {mark}. SORTEZ DU PLACARD, S'IL VOUS PLA\xCET."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 1879570495565841
    m_Localized: PATIENT {mark}. ON NE LANCE PAS D'OBJETS.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 1879570495565842
    m_Localized: LE PATIENT {mark} COURT. AIDE-SOIGNANT, VEUILLEZ INTERVENIR.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 1879570495565843
    m_Localized: LE PATIENT {mark} SE CACHE. AIDE-SOIGNANT, VEUILLEZ INTERVENIR.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  - m_Id: 1879570495565844
    m_Localized: LE PATIENT {mark} LANCE DES OBJETS. AIDE-SOIGNANT, VEUILLEZ INTERVENIR.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763194
  references:
    version: 2
