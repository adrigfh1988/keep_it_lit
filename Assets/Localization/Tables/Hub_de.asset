    m_Metadata:
      m_Items: []
  - m_Id: 392073365
    m_Localized: "DIE KELLERTREPPE IST MIT KETTEN VERSPERRT \xB7 NIMM DEN AUFZUG"
    m_Metadata:
      m_Items: []
  - m_Id: 392073366
    m_Localized: AUFZUG RUFEN
    m_Metadata:
      m_Items: []
  - m_Id: 392073367
    m_Localized: DER AUFZUG
    m_Metadata:
      m_Items: []
  - m_Id: 392073368
    m_Localized: DAS GITTER
    m_Metadata:
      m_Items: []
  - m_Id: 392073369
    m_Localized: "T\xDCREN AUFSTEMMEN"
    m_Metadata:
      m_Items: []
  - m_Id: 392073370
    m_Localized: "DAS GITTER IST ANGEKETTET \xB7 NIMM DEN AUFZUG"
    m_Metadata:
      m_Items: []
  - m_Id: 392073371
    m_Localized: DER AUFZUG BEWEGT SICH NICHT
    m_Metadata:
      m_Items: []
  - m_Id: 392073372
    m_Localized: "DER AUFZUG KOMMT NICHT \xB7 DER KESSELRAUM IST NOCH VERSCHLOSSEN"
    m_Metadata:
      m_Items: []
  - m_Id: 392073373
    m_Localized: DER AUFZUG IST STEHEN GEBLIEBEN
    m_Metadata:
      m_Items: []
  - m_Id: 392073374
    m_Localized: "DIE T\xDCREN KLEMMEN \xB7 HALTE {key}, UM SIE AUFZUSTEMMEN"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763208
  - m_Id: 392073375
    m_Localized: ETWAS KLOPFT DREIMAL.
    m_Metadata:
      m_Items: []
  - m_Id: 392073376
    m_Localized: "ES BLEIBT AN DER T\xDCR STEHEN"
    m_Metadata:
      m_Items: []
  - m_Id: 392073377
    m_Localized: JEMAND HAT STERNE AN DIE WAND GEMALT. SIE LEUCHTEN NOCH.
    m_Metadata:
      m_Items: []
  - m_Id: 104178347053056
    m_Localized: ES IST WACH. LAUF ZUR CHIRURGIE.
    m_Metadata:
      m_Items: []
  - m_Id: 1521207307923456
    m_Localized: ES IST AUF DER TREPPE. LAUF ZUM KESSELRAUM.
    m_Metadata:
      m_Items: []
  - m_Id: 1521207379226624
    m_Localized: ES KOMMT WIEDER RUNTER. DER KESSELRAUM.
    m_Metadata:
      m_Items: []
  - m_Id: 1521207379226625
    m_Localized: DU WACHST AM AUFZUG AUF. ES IST NOCH HIER UNTEN.
    m_Metadata:
      m_Items: []
  - m_Id: 1534062728048640
    m_Localized: DURCHSUCHEN
    m_Metadata:
      m_Items: []
  - m_Id: 1534062807740416
    m_Localized: DURCHSUCHT
    m_Metadata:
      m_Items: []
  - m_Id: 1534062807740417
    m_Localized: 'GEFUNDEN: {item}'
    m_Metadata:
      m_Items:
      - rid: 4707331672703763208
  - m_Id: 1534062811934720
    m_Localized: "GEFUNDEN: {item}  \xB7  WIRKT AUF DER N\xC4CHSTEN ETAGE"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763208
  - m_Id: 1534062811934721
    m_Localized: '{n} {currency} GEFUNDEN'
    m_Metadata:
      m_Items:
      - rid: 4707331672703763208
  - m_Id: 1812604049158144
    m_Localized: HEUTIGE LEKTION
    m_Metadata:
      m_Items: []
  - m_Id: 1812604141432832
    m_Localized: PATIENT NR. {n}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763208
  - m_Id: 1812604141432833
    m_Localized: BEOBACHTE DEN PATIENTEN.
    m_Metadata:
      m_Items: []
  - m_Id: 1812604141432834
    m_Localized: SPINDE {tally}  ER SIEHT NACH
    m_Metadata:
      m_Items:
      - rid: 4707331672703763208
  - m_Id: 1812604141432835
    m_Localized: "W\xDCRFE {tally}  ER IGNORIERT SIE"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763208
  - m_Id: 1812604141432836
    m_Localized: DUNKEL {tally}  ER SIEHT WEITER
    m_Metadata:
      m_Items:
      - rid: 4707331672703763208
  - m_Id: 1812604141432837
    m_Localized: "RENNEN {tally}  ER H\xD6RT DICH"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763208
  - m_Id: 1812604141432838
    m_Localized: ES LERNT.
    m_Metadata:
      m_Items: []
  - m_Id: 1812604141432839
    m_Localized: DIE LEKTION IST VORBEI.
    m_Metadata:
      m_Items: []
  - m_Id: 1812604141432840
    m_Localized: TAFEL LESEN
    m_Metadata:
      m_Items: []
  - m_Id: 1812604141432841
    m_Localized: '{n} LEKTIONEN AN DER TAFEL. ER VERGISST NIE.'
    m_Metadata:
      m_Items:
      - rid: 4707331672703763208
  - m_Id: 1812604141432842
    m_Localized: NOCH NICHTS. ER BEOBACHTET NOCH.
    m_Metadata:
      m_Items: []
  - m_Id: 1812604141432843
    m_Localized: JEMAND HAT DIE TAFEL GEWISCHT. NUR DIE LETZTE ZEILE BLIEB.
    m_Metadata:
      m_Items: []
  - m_Id: 1818893206679552
    m_Localized: "BR\xDCHE ESSEN  \xB7  AUSDAUER IM N\xC4CHSTEN STOCK"
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371328
    m_Localized: "SCHWARZBROT NEHMEN  \xB7  EINE ERSATZBATTERIE"
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371329
    m_Localized: "KALTEN TEE TRINKEN  \xB7  LEISE SCHUHE IM N\xC4CHSTEN STOCK"
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371330
    m_Localized: ES IST NOCH WARM. JEMAND WUSSTE, DASS DU KOMMST.
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371331
    m_Localized: HART WIE EIN ZIEGEL. IM INNEREN KLAPPERT ETWAS AUS METALL.
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371332
    m_Localized: KALT. ER SCHMECKT NACH STAUB, UND DEINE SCHRITTE WERDEN LEISE.
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371333
    m_Localized: "H\xC4NDE VOLL"
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371334
    m_Localized: SCHON GEHABT
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371335
    m_Localized: DU KANNST NICHTS MEHR TRAGEN.
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371336
    m_Localized: DAVON HAST DU SCHON.
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371337
    m_Localized: KARTE LESEN
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371338
    m_Localized: "SIE HOB IHR BROT IMMER F\xDCR SP\xC4TER AUF. SIE Z\xC4HLTE DIE T\xDCREN."
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371339
    m_Localized: ER KLOPFT ZWEIMAL AUF DEN TISCH. DIE ROHRE ANTWORTEN.
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371340
    m_Localized: "SEINE AUGEN SIND OFFEN. ER SCHL\xC4FT NOCH."
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371341
    m_Localized: "DER STUHL IST ZU KLEIN DAF\xDCR. ES SETZTE SICH TROTZDEM."
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371342
    m_Localized: DER DIREKTOR HAT DIESEN PLATZ SELBST GEDECKT.
    m_Metadata:
      m_Items: []
  - m_Id: 1856707763892224
    m_Localized: STIMME {tally}  ES KENNT DICH
    m_Metadata:
      m_Items:
      - rid: 4707331672703763208
  - m_Id: 1861983598538752
    m_Localized: DAS LICHT IST AUS. ALLE SIND FORT.
    m_Metadata:
      m_Items: []
  - m_Id: 1861983602733056
    m_Localized: ES IST DIR NACH OBEN GEFOLGT.
    m_Metadata:
      m_Items: []
  - m_Id: 1861983602733057
    m_Localized: "DIE T\xDCR DES DIREKTORS. LAUF."
    m_Metadata:
      m_Items: []
  - m_Id: 1861983602733058
    m_Localized: ES HAT DICH HINEINGEHEN SEHEN.
    m_Metadata:
      m_Items: []
  - m_Id: 1861983602733059
    m_Localized: ES HATTE DICH. FINDE DEIN LICHT. LAUF.
    m_Metadata:
      m_Items: []
  - m_Id: 2975284053577728
    m_Localized: DEINEN PLATZ AM TISCH EINNEHMEN
    m_Metadata:
      m_Items: []
  - m_Id: 2975284133269504
    m_Localized: "DER SECHSTE PLATZ IST GEDECKT  \xB7  DER TELLER IST NOCH WARM"
    m_Metadata:
      m_Items: []
  - m_Id: 2975284133269505
    m_Localized: "F\xDCNF K\xD6PFE HEBEN SICH IM KERZENLICHT. DIE Z\xC4HLUNG IST BEI SECHS."
    m_Metadata:
      m_Items: []
  - m_Id: 2975284133269506
    m_Localized: "AKTEN ABGEGLICHEN  \xB7  BEOBACHTUNGSBAND GEL\xD6SCHT ({habit})"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763208
  - m_Id: 2975284133269507
    m_Localized: "AKTEN ABGEGLICHEN  \xB7  BEOBACHTUNGSPROTOKOLL VERSIEGELT"
    m_Metadata:
      m_Items: []
  - m_Id: 2975284133269508
    m_Localized: "DIE T\xDCREN SIND JETZT OFFEN."
    m_Metadata:
      m_Items: []
  - m_Id: 2975284133269509
    m_Localized: "WIEDERAUFGENOMMEN  \xB7  AUFNAHME NR. 16"
    m_Metadata:
      m_Items: []
