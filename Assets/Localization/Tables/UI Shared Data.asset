    - rid: 4707331677479764494
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Pause menu: close the menu and open the floor map (420 x 86 button, 40 pt). Only shown once the map is unlocked. Noun'
    - rid: 4707331682537308448
