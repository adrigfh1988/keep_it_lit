    - rid: 4707331682537308582
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'DESCENT cause word: the blind listener that follows sound found you. Ends the sentence ''CAUSE: ...'' (a single word, all caps; it means you were heard)'
    - rid: 4707331692992135346
