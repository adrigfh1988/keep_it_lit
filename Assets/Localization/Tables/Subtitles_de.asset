%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Subtitles_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: b4c6f04b4f756474980167f6a0846058, type: 2}
  m_Metadata:
    m_Items:
    - rid: 4707331672703763191
  m_TableData:
  - m_Id: 341741568
    m_Localized: Es hat losgelassen. Das tut es kein zweites Mal.
    m_Metadata:
      m_Items: []
  - m_Id: 421433344
    m_Localized: "Bring ihn heil zur\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 421433345
    m_Localized: Wie du willst.
    m_Metadata:
      m_Items: []
  - m_Id: 421433346
    m_Localized: "Es hat das geh\xF6rt."
    m_Metadata:
      m_Items: []
  - m_Id: 421433347
    m_Localized: Keine Ersatzbatterie.
    m_Metadata:
      m_Items: []
  - m_Id: 421433348
    m_Localized: Nicht hier drin.
    m_Metadata:
      m_Items: []
  - m_Id: 421433349
    m_Localized: Die Lampe ist voll.
    m_Metadata:
      m_Items: []
  - m_Id: 421433350
    m_Localized: Frische Zelle.
    m_Metadata:
      m_Items: []
  - m_Id: 421433351
    m_Localized: Kein Sternenkompass.
    m_Metadata:
      m_Items: []
  - m_Id: 421433352
    m_Localized: Nichts mehr zum Zeigen.
    m_Metadata:
      m_Items: []
  - m_Id: 421433353
    m_Localized: DIE LUKE IST ENTRIEGELT
    m_Metadata:
      m_Items: []
  - m_Id: 441658820694016
    m_Localized: DIE AUSGANGSTORE HABEN STROM
    m_Metadata:
      m_Items: []
  - m_Id: 7992965500928
    m_Localized: BATTERIEZELLE
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387008
    m_Localized: + ZWEITER ATEM
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387009
    m_Localized: "SCHL\xDCSSEL {held} / {total}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 7993049387010
    m_Localized: +{amount} {currency}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 7993049387011
    m_Localized: Etwas wird vom Licht angezogen.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387012
    m_Localized: Irgendwo rollt ein Rollladen hoch.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387013
    m_Localized: 'CAM 3: BEWEGUNG'
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387014
    m_Localized: ES HAT GESCHRIEN.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387015
    m_Localized: AUFTRAG GESCHEITERT  -  {name}.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 7993049387016
    m_Localized: AUFTRAG ERLEDIGT  -  {name}.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 7993049387017
    m_Localized: "Hier unten glitzert nichts - der Auftrag ist hinf\xE4llig."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387018
    m_Localized: "Keine Notizen hier unten - der Auftrag ist hinf\xE4llig."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387019
    m_Localized: Abgemacht ist abgemacht.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387020
    m_Localized: Man kann nicht immer gewinnen.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387021
    m_Localized: "Splitter f\xFCr die Dunkelheit. Was darf es sein?"
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387022
    m_Localized: Schon wieder da.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387023
    m_Localized: Da oben wird es lauter.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387024
    m_Localized: Letzter Halt vor dem Grund.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387028
    m_Localized: Die Lichter sterben.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387030
    m_Localized: Es hat gewartet.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387031
    m_Localized: ETAGE {floor}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 7993049387032
    m_Localized: "ETAGE {floor} \u2014 {theme}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 7993049387033
    m_Localized: FINDE {n} STERNE
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 7993049387034
    m_Localized: SCHALTE {n} SICHERUNGEN EIN
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 7993049387035
    m_Localized: "FINDE {n} SCHL\xDCSSEL F\xDCR DIE LUKE"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 7993049387036
    m_Localized: SICHERHEITSSPERRE
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387037
    m_Localized: "{name} \u2014 {description}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 41651860836352
    m_Localized: "ES HAT DICH GEH\xD6RT."
    m_Metadata:
      m_Items: []
  - m_Id: 441658736807936
    m_Localized: DIE TORE SIND ENTRIEGELT
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972608
    m_Localized: ES ERINNERT SICH AN DIE SPINDE.
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972609
    m_Localized: ES KENNT DIE FLASCHEN.
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972610
    m_Localized: ES HAT DIE DUNKELHEIT GELERNT.
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972611
    m_Localized: "ES H\xD6RT DICH RENNEN."
    m_Metadata:
      m_Items: []
  - m_Id: 113530231492608
    m_Localized: WENN ETWAS NICHT STIMMT, KEHR UM. WENN NICHT, GEH WEITER.
    m_Metadata:
      m_Items: []
  - m_Id: 113530315378688
    m_Localized: DU ERINNERST DICH AN DAS LABYRINTH.
    m_Metadata:
      m_Items: []
  - m_Id: 113530315378689
    m_Localized: "ES L\xC4SST DICH GEHEN. EINMAL."
    m_Metadata:
      m_Items: []
  - m_Id: 390904076472320
    m_Localized: SIEH GENAU HIN. SO SOLL ES AUSSEHEN.
    m_Metadata:
      m_Items: []
  - m_Id: 405333857964032
    m_Localized: DER GRUNDRISS. NUR
    m_Metadata:
      m_Items: []
  - m_Id: 441658820694017
    m_Localized: DAS TOR IST OFFEN
    m_Metadata:
      m_Items: []
  - m_Id: 441658820694018
    m_Localized: "FINDE {n} SCHL\xDCSSEL F\xDCR DIE TORE"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 791730481696768
    m_Localized: "EIN NEBENWEG. DU MUSST NICHT. HINTER DER ECKE GIBT ES KEIN ZUR\xDCCK."
    m_Metadata:
      m_Items: []
  - m_Id: 791730569777152
    m_Localized: "{n}-MAL HINTEREINANDER RICHTIG: DIE GANZE KARTE, EINE VOLLE LAMPE UND VORR\xC4TE."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 791730569777153
    m_Localized: VOLLE LAMPE
    m_Metadata:
      m_Items: []
  - m_Id: 1860893469569024
    m_Localized: "Es hat dich weggesto\xDFen. Deine Lampe liegt am Boden."
    m_Metadata:
      m_Items: []
  - m_Id: 1860893545066496
    m_Localized: "Beim n\xE4chsten Mal l\xE4sst es nicht los."
    m_Metadata:
      m_Items: []
  - m_Id: 1860893545066497
    m_Localized: Du hast das Licht.
    m_Metadata:
      m_Items: []
  - m_Id: 1860893545066498
    m_Localized: ES KENNT DEINE STIMME.
    m_Metadata:
      m_Items: []
  - m_Id: 1874627596382208
    m_Localized: EID {rank}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 1879570495565824
    m_Localized: "HIER WAR KEINE T\xDCR."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565825
    m_Localized: "EINE T\xDCR MEHR ALS VORHER."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565826
    m_Localized: DIE ROHRE KLOPFEN ZWEIMAL.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565827
    m_Localized: DIE ROHRE KLOPFEN DREIMAL.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565828
    m_Localized: LEER. DAS TABLETT IST KALT.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565829
    m_Localized: EIN SCHILD OHNE NAMEN. NIEMAND AUF DEM TABLETT.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565830
    m_Localized: LEER. JEMAND HAT ES WIE EIN BETT GEMACHT.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565831
    m_Localized: "FACH F\xDCNF. NUR SEIN ZEHENSCHILD, WARTEND."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565832
    m_Localized: "DAS SCHILD TR\xC4GT DEINE NUMMER. DAS TABLETT IST NOCH WARM."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565833
    m_Localized: 'DEINE SACHEN LIEGEN AUF DEM TABLETT: EINE ERSATZBATTERIE.'
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565834
    m_Localized: KLARES GLAS, BLAUE KAPPE. DEIN HERZ WIRD LANGSAMER.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565835
    m_Localized: DIE ANGST VERSTUMMT. DIE WARNUNG AUCH.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565836
    m_Localized: ALLE DREI. NIEMAND BEKOMMT EINE ZU KLEINE DOSIS.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565837
    m_Localized: "DEIN HERZ IST ZUR\xDCCK."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565838
    m_Localized: "GUTEN ABEND. DIE HAUSORDNUNG IST AUSGEH\xC4NGT. DANKE."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565839
    m_Localized: PATIENT {mark}. BITTE LANGSAM GEHEN.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 1879570495565840
    m_Localized: PATIENT {mark}. BITTE RAUS AUS DEM SCHRANK.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 1879570495565841
    m_Localized: PATIENT {mark}. WIR WERFEN NICHTS.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 1879570495565842
    m_Localized: "PATIENT {mark} RENNT. PFLEGER, BITTE UNTERST\xDCTZEN."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 1879570495565843
    m_Localized: "PATIENT {mark} VERSTECKT SICH. PFLEGER, BITTE UNTERST\xDCTZEN."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  - m_Id: 1879570495565844
    m_Localized: "PATIENT {mark} WIRFT MIT DINGEN. PFLEGER, BITTE UNTERST\xDCTZEN."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763191
  references:
    version: 2
