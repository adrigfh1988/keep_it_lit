%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Subtitles_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: b4c6f04b4f756474980167f6a0846058, type: 2}
  m_Metadata:
    m_Items:
    - rid: 4707331672703763196
  m_TableData:
  - m_Id: 341741568
    m_Localized: "Te solt\xF3. No volver\xE1 a hacerlo."
    m_Metadata:
      m_Items: []
  - m_Id: 421433344
    m_Localized: "Tr\xE1elo de vuelta de una pieza."
    m_Metadata:
      m_Items: []
  - m_Id: 421433345
    m_Localized: Como quieras.
    m_Metadata:
      m_Items: []
  - m_Id: 421433346
    m_Localized: "Eso lo oy\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 421433347
    m_Localized: No tienes pila de repuesto.
    m_Metadata:
      m_Items: []
  - m_Id: 421433348
    m_Localized: "Aqu\xED dentro no."
    m_Metadata:
      m_Items: []
  - m_Id: 421433349
    m_Localized: "La linterna est\xE1 cargada."
    m_Metadata:
      m_Items: []
  - m_Id: 421433350
    m_Localized: Pila nueva.
    m_Metadata:
      m_Items: []
  - m_Id: 421433351
    m_Localized: "No tienes br\xFAjula estelar."
    m_Metadata:
      m_Items: []
  - m_Id: 421433352
    m_Localized: No queda nada a lo que apuntar.
    m_Metadata:
      m_Items: []
  - m_Id: 421433353
    m_Localized: "LA TRAMPILLA EST\xC1 DESBLOQUEADA"
    m_Metadata:
      m_Items: []
  - m_Id: 441658820694016
    m_Localized: LAS PUERTAS DE SALIDA TIENEN CORRIENTE
    m_Metadata:
      m_Items: []
  - m_Id: 7992965500928
    m_Localized: PILA
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387008
    m_Localized: + SEGUNDO ALIENTO
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387009
    m_Localized: LLAVE {held} / {total}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 7993049387010
    m_Localized: +{amount} {currency}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 7993049387011
    m_Localized: "Algo se siente atra\xEDdo por la luz."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387012
    m_Localized: "En alg\xFAn lugar, sube una persiana."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387013
    m_Localized: "C\xC1M 3: MOVIMIENTO"
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387014
    m_Localized: "ALGO GRIT\xD3."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387015
    m_Localized: CONTRATO FALLIDO  -  {name}.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 7993049387016
    m_Localized: CONTRATO CUMPLIDO  -  {name}.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 7993049387017
    m_Localized: "Aqu\xED abajo no brilla nada - el contrato queda anulado."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387018
    m_Localized: "Aqu\xED abajo no hay notas - el contrato queda anulado."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387019
    m_Localized: Trato es trato.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387020
    m_Localized: No siempre se gana.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387021
    m_Localized: "Fragmentos a cambio de algo para la oscuridad. \xBFQu\xE9 va a ser?"
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387022
    m_Localized: "Otra vez por aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387023
    m_Localized: "Ah\xED arriba hay cada vez m\xE1s ruido."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387024
    m_Localized: "\xDAltima parada antes del fondo."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387028
    m_Localized: "Las luces se est\xE1n muriendo."
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387030
    m_Localized: Estaba esperando.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387031
    m_Localized: PLANTA {floor}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 7993049387032
    m_Localized: "PLANTA {floor} \u2014 {theme}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 7993049387033
    m_Localized: ENCUENTRA {n} ESTRELLAS
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 7993049387034
    m_Localized: REPARA {n} FUSIBLES
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 7993049387035
    m_Localized: ENCUENTRA {n} LLAVES PARA LA TRAMPILLA
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 7993049387036
    m_Localized: CIERRE DE SEGURIDAD
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387037
    m_Localized: "{name} \u2014 {description}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 41651860836352
    m_Localized: "TE HA O\xCDDO."
    m_Metadata:
      m_Items: []
  - m_Id: 441658736807936
    m_Localized: "LAS PUERTAS EST\xC1N DESBLOQUEADAS"
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972608
    m_Localized: RECUERDA LOS CASILLEROS.
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972609
    m_Localized: CONOCE LAS BOTELLAS.
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972610
    m_Localized: HA APRENDIDO LA OSCURIDAD.
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972611
    m_Localized: TE OYE CORRER.
    m_Metadata:
      m_Items: []
  - m_Id: 113530231492608
    m_Localized: "SI ALGO EST\xC1 MAL, VUELVE. SI NO, SIGUE ANDANDO."
    m_Metadata:
      m_Items: []
  - m_Id: 113530315378688
    m_Localized: RECUERDAS EL LABERINTO.
    m_Metadata:
      m_Items: []
  - m_Id: 113530315378689
    m_Localized: TE DEJA IR. UNA VEZ.
    m_Metadata:
      m_Items: []
  - m_Id: 390904076472320
    m_Localized: "MIRA BIEN. AS\xCD ES COMO DEBE VERSE."
    m_Metadata:
      m_Items: []
  - m_Id: 405333857964032
    m_Localized: EL PLANO. SOLO LO QUE HAS RECORRIDO.
    m_Metadata:
      m_Items: []
  - m_Id: 441658820694017
    m_Localized: "LA PUERTA EST\xC1 ABIERTA"
    m_Metadata:
      m_Items: []
  - m_Id: 441658820694018
    m_Localized: ENCUENTRA {n} LLAVES PARA LAS PUERTAS
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 791730481696768
    m_Localized: "UN CAMINO APARTE. NO EST\xC1S OBLIGADO. PASADA LA ESQUINA NO HAY VUELTA ATR\xC1S."
    m_Metadata:
      m_Items: []
  - m_Id: 791730569777152
    m_Localized: 'ACIERTA {n} VECES SEGUIDAS: TODO EL MAPA, LA LINTERNA LLENA Y PROVISIONES.'
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 791730569777153
    m_Localized: LINTERNA LLENA
    m_Metadata:
      m_Items: []
  - m_Id: 1860893469569024
    m_Localized: "Te apart\xF3 de un empuj\xF3n. Tu linterna est\xE1 en el suelo."
    m_Metadata:
      m_Items: []
  - m_Id: 1860893545066496
    m_Localized: "La pr\xF3xima vez no te soltar\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 1860893545066497
    m_Localized: Tienes la luz.
    m_Metadata:
      m_Items: []
  - m_Id: 1860893545066498
    m_Localized: CONOCE TU VOZ.
    m_Metadata:
      m_Items: []
  - m_Id: 1874627596382208
    m_Localized: JURAMENTO {rank}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 1879570495565824
    m_Localized: "AQU\xCD NO HAB\xCDA NINGUNA PUERTA."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565825
    m_Localized: "UNA PUERTA M\xC1S QUE ANTES."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565826
    m_Localized: "LAS TUBER\xCDAS GOLPEAN DOS VECES."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565827
    m_Localized: "LAS TUBER\xCDAS GOLPEAN TRES VECES."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565828
    m_Localized: "VAC\xCDO. LA BANDEJA EST\xC1 FR\xCDA."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565829
    m_Localized: UNA ETIQUETA SIN NOMBRE. NADIE EN LA BANDEJA.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565830
    m_Localized: "VAC\xCDO. ALGUIEN LO HA HECHO COMO UNA CAMA."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565831
    m_Localized: "CAJ\xD3N CINCO. SOLO SU ETIQUETA, ESPERANDO."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565832
    m_Localized: "LA ETIQUETA LLEVA TU N\xDAMERO. LA BANDEJA A\xDAN EST\xC1 TIBIA."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565833
    m_Localized: "TUS COSAS EST\xC1N EN LA BANDEJA: UNA PILA DE REPUESTO."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565834
    m_Localized: "VIDRIO CLARO, TAP\xD3N AZUL. TU CORAZ\xD3N SE CALMA."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565835
    m_Localized: "EL MIEDO CALLA. LA ADVERTENCIA TAMBI\xC9N."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565836
    m_Localized: LAS TRES. NADIE RECIBE UNA DOSIS CORTA.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565837
    m_Localized: "TU CORAZ\xD3N HA VUELTO."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565838
    m_Localized: "BUENAS NOCHES. LAS NORMAS DE LA CASA EST\xC1N PUBLICADAS. GRACIAS."
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565839
    m_Localized: PACIENTE {mark}. AL PASO, POR FAVOR.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 1879570495565840
    m_Localized: PACIENTE {mark}. FUERA DEL ARMARIO, POR FAVOR.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 1879570495565841
    m_Localized: "PACIENTE {mark}. AQU\xCD NO SE TIRAN COSAS."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 1879570495565842
    m_Localized: "EL PACIENTE {mark} EST\xC1 CORRIENDO. CELADOR, ASISTA, POR FAVOR."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 1879570495565843
    m_Localized: EL PACIENTE {mark} SE ESCONDE. CELADOR, ASISTA, POR FAVOR.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 1879570495565844
    m_Localized: EL PACIENTE {mark} LANZA OBJETOS. CELADOR, ASISTA, POR FAVOR.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763196
  - m_Id: 4814051127234560
    m_Localized: "TU ALIENTO SE VUELVE BLANCO. \xC9L NO QUIERE LAS LUCES ENCENDIDAS."
    m_Metadata:
      m_Items: []
  - m_Id: 4814051202732032
    m_Localized: "LA ESCARCHA SE HACE M\xC1S PROFUNDA. M\xC1S L\xC1MPARAS SE APAGAN."
    m_Metadata:
      m_Items: []
  - m_Id: 4814051202732033
    m_Localized: "LAS L\xC1MPARAS DE LOS REFUGIOS SE EST\xC1N CONGELANDO."
    m_Metadata:
      m_Items: []
  - m_Id: 4814051202732034
    m_Localized: "APAG\xD3N TOTAL. LA OSCURIDAD ES SUYA."
    m_Metadata:
      m_Items: []
  - m_Id: 4814051202732035
    m_Localized: "UNA L\xC1MPARA ESTALLA EN EL FR\xCDO."
    m_Metadata:
      m_Items: []
  - m_Id: 4814051202732036
    m_Localized: EL HAZ CONCENTRADO LE QUEMA LOS OJOS.
    m_Metadata:
      m_Items: []
  - m_Id: 4814051202732037
    m_Localized: OYE TU ALIENTO HELADO.
    m_Metadata:
      m_Items: []
  - m_Id: 4814051202732038
    m_Localized: ENTUMECIDO POR EL HIELO. CORRE ANTES DE QUE VUELVA TU LINTERNA.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds:
