  m_Name: Voices_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 142449efb3c77344abb64fc4d747b015, type: 2}
  m_Metadata:
    m_Items:
    - rid: 4707331672703763195
  m_TableData:
  - m_Id: 295604224
    m_Localized: no parpadees.
    m_Metadata:
      m_Items: []
  - m_Id: 379490304
    m_Localized: "ah\xED est\xE1 mi lucecita."
    m_Metadata:
      m_Items: []
  - m_Id: 379490305
    m_Localized: corre.
    m_Metadata:
      m_Items: []
  - m_Id: 379490306
    m_Localized: me perteneces.
    m_Metadata:
      m_Items: []
  - m_Id: 379490307
    m_Localized: vas muy despacio.
    m_Metadata:
      m_Items: []
  - m_Id: 379490308
    m_Localized: huelo tu pila.
    m_Metadata:
      m_Items: []
  - m_Id: 379490309
    m_Localized: "hola, ladr\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 379490310
    m_Localized: "corre m\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 379490311
    m_Localized: te pesan las piernas.
    m_Metadata:
      m_Items: []
  - m_Id: 379490312
    m_Localized: yo no me canso.
    m_Metadata:
      m_Items: []
  - m_Id: 379490313
    m_Localized: "m\xE1s cerca\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490314
    m_Localized: "las estrellas no te salvar\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 379490315
    m_Localized: sigue corriendo. me gusta.
    m_Metadata:
      m_Items: []
  - m_Id: 379490316
    m_Localized: no puedes esconderte para siempre.
    m_Metadata:
      m_Items: []
  - m_Id: 379490317
    m_Localized: "te encontrar\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 379490318
    m_Localized: conozco mejor este laberinto.
    m_Metadata:
      m_Items: []
  - m_Id: 379490319
    m_Localized: "\xBFte escondes? bien."
    m_Metadata:
      m_Items: []
  - m_Id: 379490320
    m_Localized: "\xBFd\xF3nde est\xE1s\u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490321
    m_Localized: sal.
    m_Metadata:
      m_Items: []
  - m_Id: 379490322
    m_Localized: "oigo tu coraz\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 379490323
    m_Localized: "lucecita, lucecita\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490324
    m_Localized: "la oscuridad es m\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 379490325
    m_Localized: "planta {floor}. no saldr\xE1s de ella."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763195
  - m_Id: 379490326
    m_Localized: SORPRESA.
    m_Metadata:
      m_Items: []
  - m_Id: 379490327
    m_Localized: TANTO TIEMPO ESPERANDO.
    m_Metadata:
      m_Items: []
  - m_Id: 379490328
    m_Localized: "\xBFPOR AQU\xCD? BIEN."
    m_Metadata:
      m_Items: []
  - m_Id: 379490329
    m_Localized: HOLA.
    m_Metadata:
      m_Items: []
  - m_Id: 379490330
    m_Localized: "\xBFhay alguien ah\xED dentro?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490331
    m_Localized: te huelo.
    m_Metadata:
      m_Items: []
  - m_Id: 379490332
    m_Localized: abre.
    m_Metadata:
      m_Items: []
  - m_Id: 379490333
    m_Localized: "uno de estos\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490334
    m_Localized: metal tibio.
    m_Metadata:
      m_Items: []
  - m_Id: 379490335
    m_Localized: las puertas no me detienen.
    m_Metadata:
      m_Items: []
  - m_Id: 379490336
    m_Localized: "d\xE9jame entrar."
    m_Metadata:
      m_Items: []
  - m_Id: 379490337
    m_Localized: toc, toc.
    m_Metadata:
      m_Items: []
  - m_Id: 379490338
    m_Localized: se acabaron las puertas.
    m_Metadata:
      m_Items: []
  - m_Id: 379490339
    m_Localized: "TE ATRAP\xC9."
    m_Metadata:
      m_Items: []
  - m_Id: 379490340
    m_Localized: TE TENGO.
    m_Metadata:
      m_Items: []
  - m_Id: 379490341
    m_Localized: A OSCURAS.
    m_Metadata:
      m_Items: []
  - m_Id: 379490342
    m_Localized: "TE ENCONTR\xC9."
    m_Metadata:
      m_Items: []
  - m_Id: 379490343
    m_Localized: "ah\xED est\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 379490344
    m_Localized: te veo.
    m_Metadata:
      m_Items: []
  - m_Id: 379490345
    m_Localized: "te encontr\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 379490346
    m_Localized: hola otra vez.
    m_Metadata:
      m_Items: []
  - m_Id: 379490347
    m_Localized: "cuc\xFA."
    m_Metadata:
      m_Items: []
  - m_Id: 379490348
    m_Localized: no corras. por favor, corre.
    m_Metadata:
      m_Items: []
  - m_Id: 379490349
    m_Localized: tienes cara de cansancio.
    m_Metadata:
      m_Items: []
  - m_Id: 379490350
    m_Localized: te estaba esperando.
    m_Metadata:
      m_Items: []
  - m_Id: 379490351
    m_Localized: demasiada luz.
    m_Metadata:
      m_Items: []
  - m_Id: 379490352
    m_Localized: "no podr\xE1s tenerla encendida siempre."
    m_Metadata:
      m_Items: []
  - m_Id: 379490353
    m_Localized: clic. clic.
    m_Metadata:
      m_Items: []
  - m_Id: 379490354
    m_Localized: parpadea.
    m_Metadata:
      m_Items: []
  - m_Id: 379490355
    m_Localized: "esperar\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 379490356
    m_Localized: se te muere la pila.
    m_Metadata:
      m_Items: []
  - m_Id: 379490357
    m_Localized: "\xBFjugamos a las estatuas?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490358
    m_Localized: no apartes la vista.
    m_Metadata:
      m_Items: []
  - m_Id: 379490359
    m_Localized: sin moverte.
    m_Metadata:
      m_Items: []
  - m_Id: 379490360
    m_Localized: "uno\u2026 dos\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490361
    m_Localized: shhh.
    m_Metadata:
      m_Items: []
  - m_Id: 379490362
    m_Localized: "d\xE9jame mirarte."
    m_Metadata:
      m_Items: []
  - m_Id: 379490363
    m_Localized: "m\xE1s cerca."
    m_Metadata:
      m_Items: []
  - m_Id: 379490364
    m_Localized: no te muevas.
    m_Metadata:
      m_Items: []
  - m_Id: 379490365
    m_Localized: BU.
    m_Metadata:
      m_Items: []
  - m_Id: 379490366
    m_Localized: "\xA1TE TOQU\xC9!"
    m_Metadata:
      m_Items: []
  - m_Id: 379490367
    m_Localized: "TE TENGO\u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 379490368
    m_Localized: "PARA M\xCD."
    m_Metadata:
      m_Items: []
  - m_Id: 379490369
    m_Localized: AHORA.
    m_Metadata:
      m_Items: []
  - m_Id: 379490370
    m_Localized: "te toqu\xE9. ahora la llevas t\xFA."
    m_Metadata:
      m_Items: []
  - m_Id: 379490371
    m_Localized: calentito.
    m_Metadata:
      m_Items: []
  - m_Id: 379490372
    m_Localized: "\xE9l lo oy\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 379490373
    m_Localized: "le dije d\xF3nde est\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 379490374
    m_Localized: tu luz sabe rica.
    m_Metadata:
      m_Items: []
  - m_Id: 379490375
    m_Localized: "\xBFad\xF3nde fuiste?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490376
    m_Localized: entonces, a jugar a esconderse.
    m_Metadata:
      m_Items: []
  - m_Id: 379490377
    m_Localized: te oigo respirar.
    m_Metadata:
      m_Items: []
  - m_Id: 379490378
    m_Localized: "volver\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 379490379
    m_Localized: "all\xE1 voy\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490380
    m_Localized: toc, toc.
    m_Metadata:
      m_Items: []
  - m_Id: 379490381
    m_Localized: "s\xE9 en cu\xE1l est\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 379490382
    m_Localized: "qu\xE9 estrecho se est\xE1 ah\xED dentro, \xBFverdad?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490383
    m_Localized: "sal, sal de ah\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 379490384
    m_Localized: puedo esperar toda la noche.
    m_Metadata:
      m_Items: []
  - m_Id: 379490385
    m_Localized: "\xBFte gusta el laberinto?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490386
    m_Localized: "\xE9l est\xE1 m\xE1s cerca que yo."
    m_Metadata:
      m_Items: []
  - m_Id: 379490387
    m_Localized: planta {floor}. ya quedan pocas.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763195
  - m_Id: 379490388
    m_Localized: "tu coraz\xF3n hace mucho ruido."
    m_Metadata:
      m_Items: []
  - m_Id: 379490389
    m_Localized: las estrellas no son para ti.
    m_Metadata:
      m_Items: []
  - m_Id: 379490390
    m_Localized: sigue caminando.
    m_Metadata:
      m_Items: []
  - m_Id: 379490391
    m_Localized: Cuarenta y una puertas. Ayer, cuarenta.
    m_Metadata:
      m_Items: []
  - m_Id: 379490392
    m_Localized: No abras la nueva.
    m_Metadata:
      m_Items: []
  - m_Id: 379490393
    m_Localized: Cuenta conmigo. Una...
    m_Metadata:
      m_Items: []
  - m_Id: 379490394
    m_Localized: "Le\xEDste mi expediente. As\xED que t\xFA tambi\xE9n cuentas."
    m_Metadata:
      m_Items: []
  - m_Id: 379490395
    m_Localized: Cuarenta y cuatro. No dejan de aparecer.
    m_Metadata:
      m_Items: []
  - m_Id: 379490396
    m_Localized: "Una puerta m\xE1s. La tuya."
    m_Metadata:
      m_Items: []
  - m_Id: 379490397
    m_Localized: Dos golpes. Todo despejado.
    m_Metadata:
      m_Items: []
  - m_Id: 379490398
    m_Localized: "Escucha. \xBFLos oyes caminar?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490399
    m_Localized: "Las tuber\xEDas est\xE1n calientes esta noche."
    m_Metadata:
      m_Items: []
  - m_Id: 379490400
    m_Localized: "Escribieron que respondo a las tuber\xEDas. Ellas me responden."
    m_Metadata:
      m_Items: []
  - m_Id: 379490401
    m_Localized: "Tres. Tres golpes. Esc\xF3ndete."
    m_Metadata:
      m_Items: []
  - m_Id: 379490402
    m_Localized: "Dej\xF3 de golpear. \xBFPor qu\xE9 par\xF3?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490403
    m_Localized: "Los cajones est\xE1n fr\xEDos. El m\xEDo es el cinco."
    m_Metadata:
      m_Items: []
  - m_Id: 379490404
    m_Localized: "Camino de noche. No recuerdo por d\xF3nde."
    m_Metadata:
      m_Items: []
  - m_Id: 379490405
    m_Localized: "Viste el caj\xF3n cinco. \xBFTen\xEDa mi nombre?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490406
    m_Localized: "Ma\xF1ana me trasladan a Cirug\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 379490407
    m_Localized: Gracias por bajar.
    m_Metadata:
      m_Items: []
