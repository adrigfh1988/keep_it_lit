      m_Items: []
  - m_Id: 392073364
    m_Localized: "BUSCA LA LLAVE DEL DIRECTOR \xB7 ARCHIVO"
    m_Metadata:
      m_Items: []
  - m_Id: 392073365
    m_Localized: "LA ESCALERA AL S\xD3TANO EST\xC1 ENCADENADA \xB7 TOMA EL ASCENSOR"
    m_Metadata:
      m_Items: []
  - m_Id: 392073366
    m_Localized: LLAMAR AL ASCENSOR
    m_Metadata:
      m_Items: []
  - m_Id: 392073367
    m_Localized: EL ASCENSOR
    m_Metadata:
      m_Items: []
  - m_Id: 392073368
    m_Localized: LA REJA
    m_Metadata:
      m_Items: []
  - m_Id: 392073369
    m_Localized: FORZAR LAS PUERTAS
    m_Metadata:
      m_Items: []
  - m_Id: 392073370
    m_Localized: "LA REJA EST\xC1 ENCADENADA \xB7 TOMA EL ASCENSOR"
    m_Metadata:
      m_Items: []
  - m_Id: 392073371
    m_Localized: EL ASCENSOR NO SE MUEVE
    m_Metadata:
      m_Items: []
  - m_Id: 392073372
    m_Localized: "EL ASCENSOR NO VIENE \xB7 LA SALA DE CALDERAS SIGUE BLOQUEADA"
    m_Metadata:
      m_Items: []
  - m_Id: 392073373
    m_Localized: EL ASCENSOR SE DETUVO
    m_Metadata:
      m_Items: []
  - m_Id: 392073374
    m_Localized: "LAS PUERTAS EST\xC1N ATASCADAS \xB7 MANT\xC9N {key} PARA FORZARLAS"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763214
  - m_Id: 392073375
    m_Localized: ALGO GOLPEA TRES VECES.
    m_Metadata:
      m_Items: []
  - m_Id: 392073376
    m_Localized: SE DETIENE EN LA PUERTA
    m_Metadata:
      m_Items: []
  - m_Id: 392073377
    m_Localized: "ALGUIEN HA DIBUJADO ESTRELLAS EN LA PARED. TODAV\xCDA BRILLAN."
    m_Metadata:
      m_Items: []
  - m_Id: 104178347053056
    m_Localized: "EST\xC1 DESPIERTO. CORRE A CIRUG\xCDA."
    m_Metadata:
      m_Items: []
  - m_Id: 1521207307923456
    m_Localized: "EST\xC1 EN LA ESCALERA. CORRE A LA SALA DE CALDERAS."
    m_Metadata:
      m_Items: []
  - m_Id: 1521207379226624
    m_Localized: VUELVE A BAJAR. LA SALA DE CALDERAS.
    m_Metadata:
      m_Items: []
  - m_Id: 1521207379226625
    m_Localized: "DESPIERTAS JUNTO AL ASCENSOR. SIGUE AQU\xCD ABAJO."
    m_Metadata:
      m_Items: []
  - m_Id: 1534062728048640
    m_Localized: REGISTRAR
    m_Metadata:
      m_Items: []
  - m_Id: 1534062807740416
    m_Localized: REGISTRADO
    m_Metadata:
      m_Items: []
  - m_Id: 1534062807740417
    m_Localized: 'ENCONTRADO: {item}'
    m_Metadata:
      m_Items:
      - rid: 4707331672703763214
  - m_Id: 1534062811934720
    m_Localized: "ENCONTRADO: {item}  \xB7  FUNCIONA EN LA SIGUIENTE PLANTA"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763214
  - m_Id: 1534062811934721
    m_Localized: ENCONTRADOS {n} {currency}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763214
