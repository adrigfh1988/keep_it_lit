%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Subtitles_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: b4c6f04b4f756474980167f6a0846058, type: 2}
  m_Metadata:
    m_Items:
    - rid: 4707331672703763132
  m_TableData:
  - m_Id: 341741568
    m_Localized: It let go. It will not do that twice.
    m_Metadata:
      m_Items: []
  - m_Id: 421433344
    m_Localized: Bring it back in one piece.
    m_Metadata:
      m_Items: []
  - m_Id: 421433345
    m_Localized: Suit yourself.
    m_Metadata:
      m_Items: []
  - m_Id: 421433346
    m_Localized: It heard that.
    m_Metadata:
      m_Items: []
  - m_Id: 421433347
    m_Localized: No spare battery.
    m_Metadata:
      m_Items: []
  - m_Id: 421433348
    m_Localized: Not in here.
    m_Metadata:
      m_Items: []
  - m_Id: 421433349
    m_Localized: The torch is full.
    m_Metadata:
      m_Items: []
  - m_Id: 421433350
    m_Localized: Fresh cell.
    m_Metadata:
      m_Items: []
  - m_Id: 421433351
    m_Localized: No star compass.
    m_Metadata:
      m_Items: []
  - m_Id: 421433352
    m_Localized: Nothing left to point at.
    m_Metadata:
      m_Items: []
  - m_Id: 421433353
    m_Localized: THE HATCH IS UNLOCKED
    m_Metadata:
      m_Items: []
  - m_Id: 441658820694016
    m_Localized: THE EXIT GATES HAVE POWER
    m_Metadata:
      m_Items: []
  - m_Id: 7992965500928
    m_Localized: BATTERY CELL
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387008
    m_Localized: + SECOND WIND
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387009
    m_Localized: KEY {held} / {total}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 7993049387010
    m_Localized: +{amount} {currency}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 7993049387011
    m_Localized: Something is drawn to the light.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387012
    m_Localized: Somewhere, a shutter rolls up.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387013
    m_Localized: 'CAM 3: MOVEMENT'
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387014
    m_Localized: IT SCREAMED.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387015
    m_Localized: CONTRACT FAILED  -  {name}.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 7993049387016
    m_Localized: CONTRACT DONE  -  {name}.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 7993049387017
    m_Localized: Nothing glitters down here - the contract's off.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387018
    m_Localized: No notes down here - the contract's off.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387019
    m_Localized: A deal's a deal.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387020
    m_Localized: Can't win them all.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387021
    m_Localized: Shards for the dark. What'll it be?
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387022
    m_Localized: Back again.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387023
    m_Localized: It's getting louder up there.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387024
    m_Localized: Last stop before the bottom.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387028
    m_Localized: The lights are dying.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387030
    m_Localized: It was waiting.
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387031
    m_Localized: FLOOR {floor}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 7993049387032
    m_Localized: "FLOOR {floor} \u2014 {theme}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 7993049387033
    m_Localized: FIND {n} STARS
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 7993049387034
    m_Localized: RESTORE {n} FUSES
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 7993049387035
    m_Localized: FIND {n} KEYS FOR THE HATCH
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 7993049387036
    m_Localized: SECURITY LOCKDOWN
    m_Metadata:
      m_Items: []
  - m_Id: 7993049387037
    m_Localized: "{name} \u2014 {description}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 41651860836352
    m_Localized: IT HEARD YOU.
    m_Metadata:
      m_Items: []
  - m_Id: 441658736807936
    m_Localized: THE GATES ARE UNLOCKED
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972608
    m_Localized: IT REMEMBERS THE LOCKERS.
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972609
    m_Localized: IT KNOWS THE BOTTLES.
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972610
    m_Localized: IT HAS LEARNED THE DARK.
    m_Metadata:
      m_Items: []
  - m_Id: 82051979972611
    m_Localized: IT HEARS YOU RUN.
    m_Metadata:
      m_Items: []
  - m_Id: 113530231492608
    m_Localized: IF SOMETHING IS WRONG, TURN BACK. IF NOT, KEEP WALKING.
    m_Metadata:
      m_Items: []
  - m_Id: 113530315378688
    m_Localized: YOU REMEMBER THE MAZE.
    m_Metadata:
      m_Items: []
  - m_Id: 113530315378689
    m_Localized: IT LETS YOU GO. ONCE.
    m_Metadata:
      m_Items: []
  - m_Id: 390904076472320
    m_Localized: LOOK CAREFULLY. THIS IS HOW IT SHOULD LOOK.
    m_Metadata:
      m_Items: []
  - m_Id: 405333857964032
    m_Localized: THE FLOOR PLAN. ONLY WHAT YOU HAVE WALKED.
    m_Metadata:
      m_Items: []
  - m_Id: 441658820694017
    m_Localized: THE GATE IS OPEN
    m_Metadata:
      m_Items: []
  - m_Id: 441658820694018
    m_Localized: FIND {n} KEYS FOR THE GATES
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 791730481696768
    m_Localized: A SIDE PATH. YOU DO NOT HAVE TO. PAST THE CORNER THERE IS NO WAY BACK.
    m_Metadata:
      m_Items: []
  - m_Id: 791730569777152
    m_Localized: 'GET IT RIGHT {n} TIMES IN A ROW: THE WHOLE MAP, A FULL TORCH AND SUPPLIES.'
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 791730569777153
    m_Localized: FULL TORCH
    m_Metadata:
      m_Items: []
  - m_Id: 1860893469569024
    m_Localized: It threw you off. Your torch is on the floor.
    m_Metadata:
      m_Items: []
  - m_Id: 1860893545066496
    m_Localized: Next time it will not let go.
    m_Metadata:
      m_Items: []
  - m_Id: 1860893545066497
    m_Localized: You have the light.
    m_Metadata:
      m_Items: []
  - m_Id: 1860893545066498
    m_Localized: IT KNOWS YOUR VOICE.
    m_Metadata:
      m_Items: []
  - m_Id: 1874627596382208
    m_Localized: OATH {rank}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 1879570495565824
    m_Localized: THERE WAS NO DOOR HERE.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565825
    m_Localized: ONE MORE DOOR THAN BEFORE.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565826
    m_Localized: THE PIPES KNOCK TWICE.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565827
    m_Localized: THE PIPES KNOCK THREE TIMES.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565828
    m_Localized: EMPTY. THE TRAY IS COLD.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565829
    m_Localized: A TAG WITH NO NAME. NOBODY ON THE TRAY.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565830
    m_Localized: EMPTY. SOMEONE HAS MADE IT UP LIKE A BED.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565831
    m_Localized: DRAWER FIVE. ONLY HIS TOE TAG, WAITING.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565832
    m_Localized: THE TAG HAS YOUR NUMBER. THE TRAY IS STILL WARM.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565833
    m_Localized: 'YOUR THINGS ARE ON THE TRAY: A SPARE BATTERY.'
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565834
    m_Localized: CLEAR GLASS, BLUE CAP. YOUR HEART SLOWS.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565835
    m_Localized: THE FEAR GOES QUIET. SO DOES THE WARNING.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565836
    m_Localized: ALL THREE. NOBODY GETS A SHORT DOSE.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565837
    m_Localized: YOUR HEART IS BACK.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565838
    m_Localized: GOOD EVENING. THE HOUSE RULES ARE POSTED. THANK YOU.
    m_Metadata:
      m_Items: []
  - m_Id: 1879570495565839
    m_Localized: PATIENT {mark}. WALKING PACE, PLEASE.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 1879570495565840
    m_Localized: PATIENT {mark}. OUT OF THE CUPBOARD, PLEASE.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 1879570495565841
    m_Localized: PATIENT {mark}. WE DO NOT THROW THINGS.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 1879570495565842
    m_Localized: PATIENT {mark} IS RUNNING. ORDERLY, PLEASE ASSIST.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 1879570495565843
    m_Localized: PATIENT {mark} IS HIDING. ORDERLY, PLEASE ASSIST.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 1879570495565844
    m_Localized: PATIENT {mark} IS THROWING THINGS. ORDERLY, PLEASE ASSIST.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763132
  - m_Id: 4814051127234560
    m_Localized: YOUR BREATH TURNS WHITE. HE DOES NOT WANT THE LIGHTS ON.
    m_Metadata:
      m_Items: []
  - m_Id: 4814051202732032
    m_Localized: THE FROST DEEPENS. MORE LAMPS ARE DYING.
    m_Metadata:
      m_Items: []
  - m_Id: 4814051202732033
    m_Localized: THE SANCTUARY LAMPS ARE FREEZING OVER.
    m_Metadata:
      m_Items: []
  - m_Id: 4814051202732034
    m_Localized: TOTAL BLACKOUT. HE OWNS THE DARK.
    m_Metadata:
      m_Items: []
  - m_Id: 4814051202732035
    m_Localized: A LAMP SHATTERS IN THE COLD.
    m_Metadata:
      m_Items: []
  - m_Id: 4814051202732036
    m_Localized: THE FOCUSED BEAM BURNS HIS EYES.
    m_Metadata:
      m_Items: []
  - m_Id: 4814051202732037
    m_Localized: HE HEARS YOUR FROZEN BREATH.
    m_Metadata:
      m_Items: []
  - m_Id: 4814051202732038
    m_Localized: FROSTNUMB. RUN BEFORE YOUR TORCH COMES BACK.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds:
