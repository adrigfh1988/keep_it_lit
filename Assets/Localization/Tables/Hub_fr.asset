    m_Metadata:
      m_Items: []
  - m_Id: 392073362
    m_Localized: "LE TIROIR EST VERROUILL\xC9 \xB7 DOSSIERS {n} / {total}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763192
  - m_Id: 392073363
    m_Localized: "LA CL\xC9 DU DIRECTEUR \xB7 LA PORTE EST D\xC9VERROUILL\xC9E"
    m_Metadata:
      m_Items: []
  - m_Id: 392073364
    m_Localized: "TROUVER LA CL\xC9 DU DIRECTEUR \xB7 SALLE DES ARCHIVES"
    m_Metadata:
      m_Items: []
  - m_Id: 392073365
    m_Localized: "L'ESCALIER DU SOUS-SOL EST ENCHA\xCEN\xC9 \xB7 PRENEZ L'ASCENSEUR"
    m_Metadata:
      m_Items: []
  - m_Id: 392073366
    m_Localized: APPELER L'ASCENSEUR
    m_Metadata:
      m_Items: []
  - m_Id: 392073367
    m_Localized: L'ASCENSEUR
    m_Metadata:
      m_Items: []
  - m_Id: 392073368
    m_Localized: LA GRILLE
    m_Metadata:
      m_Items: []
  - m_Id: 392073369
    m_Localized: FORCER LES PORTES
    m_Metadata:
      m_Items: []
  - m_Id: 392073370
    m_Localized: "LA GRILLE EST ENCHA\xCEN\xC9E \xB7 PRENEZ L'ASCENSEUR"
    m_Metadata:
      m_Items: []
  - m_Id: 392073371
    m_Localized: L'ASCENSEUR NE BOUGE PAS
    m_Metadata:
      m_Items: []
  - m_Id: 392073372
    m_Localized: "L'ASCENSEUR NE VIENT PAS \xB7 LA CHAUFFERIE EST TOUJOURS VERROUILL\xC9E"
    m_Metadata:
      m_Items: []
  - m_Id: 392073373
    m_Localized: "L'ASCENSEUR S'EST ARR\xCAT\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 392073374
    m_Localized: "LES PORTES SONT COINC\xC9ES \xB7 MAINTENEZ {key} POUR LES FORCER"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763192
  - m_Id: 392073375
    m_Localized: QUELQUE CHOSE FRAPPE TROIS COUPS.
    m_Metadata:
      m_Items: []
  - m_Id: 392073376
    m_Localized: "\xC7A S'ARR\xCATE \xC0 LA PORTE"
    m_Metadata:
      m_Items: []
  - m_Id: 392073377
    m_Localized: "QUELQU'UN A DESSIN\xC9 DES \xC9TOILES SUR LE MUR. ELLES BRILLENT ENCORE."
    m_Metadata:
      m_Items: []
  - m_Id: 104178347053056
    m_Localized: "\xC7A S'EST R\xC9VEILL\xC9. VITE, \xC0 LA CHIRURGIE."
    m_Metadata:
      m_Items: []
  - m_Id: 1521207307923456
    m_Localized: "\xC7A DESCEND L'ESCALIER. COURS \xC0 LA CHAUFFERIE."
    m_Metadata:
      m_Items: []
  - m_Id: 1521207379226624
    m_Localized: "\xC7A REDESCEND. LA CHAUFFERIE."
    m_Metadata:
      m_Items: []
  - m_Id: 1521207379226625
    m_Localized: "TU TE R\xC9VEILLES PR\xC8S DE L'ASCENSEUR. \xC7A EST TOUJOURS EN BAS."
    m_Metadata:
      m_Items: []
  - m_Id: 1534062728048640
    m_Localized: FOUILLER
    m_Metadata:
      m_Items: []
  - m_Id: 1534062807740416
    m_Localized: "FOUILL\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 1534062807740417
    m_Localized: "TROUV\xC9: {item}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763192
  - m_Id: 1534062811934720
    m_Localized: "TROUV\xC9: {item}  \xB7  FONCTIONNE \xC0 L'\xC9TAGE SUIVANT"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763192
  - m_Id: 1534062811934721
    m_Localized: "TROUV\xC9 {n} {currency}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763192
  - m_Id: 1812604049158144
    m_Localized: "LE\xC7ON DU JOUR"
    m_Metadata:
      m_Items: []
  - m_Id: 1812604141432832
    m_Localized: "PATIENT N\xB0{n}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763192
  - m_Id: 1812604141432833
    m_Localized: OBSERVEZ LE PATIENT.
    m_Metadata:
      m_Items: []
  - m_Id: 1812604141432834
    m_Localized: CASIERS {tally}  IL LES FOUILLE
    m_Metadata:
      m_Items:
      - rid: 4707331672703763192
  - m_Id: 1812604141432835
    m_Localized: JETS {tally}  IL LES IGNORE
    m_Metadata:
      m_Items:
      - rid: 4707331672703763192
  - m_Id: 1812604141432836
    m_Localized: NOIR {tally}  IL VOIT PLUS LOIN
    m_Metadata:
      m_Items:
      - rid: 4707331672703763192
  - m_Id: 1812604141432837
    m_Localized: COURSE {tally}  IL VOUS ENTEND
    m_Metadata:
      m_Items:
      - rid: 4707331672703763192
  - m_Id: 1812604141432838
    m_Localized: IL APPREND.
    m_Metadata:
      m_Items: []
  - m_Id: 1812604141432839
    m_Localized: "LA LE\xC7ON EST FINIE."
    m_Metadata:
      m_Items: []
  - m_Id: 1812604141432840
    m_Localized: LIRE LE TABLEAU
    m_Metadata:
      m_Items: []
  - m_Id: 1812604141432841
    m_Localized: "{n} LE\xC7ONS AU TABLEAU. IL N'OUBLIE JAMAIS."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763192
  - m_Id: 1812604141432842
    m_Localized: RIEN POUR L'INSTANT. IL OBSERVE ENCORE.
    m_Metadata:
      m_Items: []
  - m_Id: 1812604141432843
    m_Localized: "QUELQU'UN A EFFAC\xC9 LE TABLEAU. IL NE RESTE QUE LA DERNI\xC8RE LIGNE."
    m_Metadata:
      m_Items: []
  - m_Id: 1818893206679552
    m_Localized: "MANGER LE BOUILLON  \xB7  ENDURANCE \xC0 L'\xC9TAGE SUIVANT"
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371328
    m_Localized: "PRENDRE LE PAIN NOIR  \xB7  UNE PILE DE RECHANGE"
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371329
    m_Localized: "BOIRE LE TH\xC9 FROID  \xB7  CHAUSSURES SILENCIEUSES \xC0 L'\xC9TAGE SUIVANT"
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371330
    m_Localized: IL EST ENCORE CHAUD. QUELQU'UN SAVAIT QUE VOUS VIENDRIEZ.
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371331
    m_Localized: "DUR COMME UNE BRIQUE. QUELQUE CHOSE DE M\xC9TALLIQUE CLIQUETTE DEDANS."
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371332
    m_Localized: "FROID. IL A GO\xDBT DE POUSSI\xC8RE, ET VOS PAS S'ADOUCISSENT."
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371333
    m_Localized: MAINS PLEINES
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371334
    m_Localized: "D\xC9J\xC0 SERVI"
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371335
    m_Localized: VOUS NE POUVEZ PLUS RIEN PORTER.
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371336
    m_Localized: "VOUS EN AVEZ D\xC9J\xC0."
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371337
    m_Localized: LIRE LA CARTE
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371338
    m_Localized: ELLE GARDAIT TOUJOURS SON PAIN POUR PLUS TARD. ELLE COMPTAIT LES PORTES.
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371339
    m_Localized: "IL FRAPPE DEUX FOIS SUR LA TABLE. LES TUYAUX R\xC9PONDENT."
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371340
    m_Localized: SES YEUX SONT OUVERTS. IL DORT ENCORE.
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371341
    m_Localized: "LA CHAISE EST TROP PETITE POUR \xC7A. IL S'EST ASSIS QUAND M\xCAME."
    m_Metadata:
      m_Items: []
  - m_Id: 1818893286371342
    m_Localized: "LE DIRECTEUR A MIS CE COUVERT LUI-M\xCAME."
    m_Metadata:
      m_Items: []
  - m_Id: 1856707763892224
    m_Localized: "VOIX {tally}  \xC7A TE CONNA\xCET"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763192
  - m_Id: 1861983598538752
    m_Localized: "LES LUMI\xC8RES SONT \xC9TEINTES. TOUT LE MONDE A DISPARU."
    m_Metadata:
      m_Items: []
  - m_Id: 1861983602733056
    m_Localized: "\xC7A T'A SUIVI JUSQU'ICI."
    m_Metadata:
      m_Items: []
  - m_Id: 1861983602733057
    m_Localized: LA PORTE DU DIRECTEUR. COURS.
    m_Metadata:
      m_Items: []
  - m_Id: 1861983602733058
    m_Localized: "\xC7A T'A VU ENTRER."
    m_Metadata:
      m_Items: []
  - m_Id: 1861983602733059
    m_Localized: "\xC7A TE TENAIT. RETROUVE TA LAMPE. COURS."
    m_Metadata:
      m_Items: []
  - m_Id: 2975284053577728
    m_Localized: "PRENDRE VOTRE PLACE \xC0 TABLE"
    m_Metadata:
      m_Items: []
  - m_Id: 2975284133269504
    m_Localized: "LE SIXI\xC8ME COUVERT EST MIS  \xB7  L'ASSIETTE EST ENCORE TI\xC8DE"
    m_Metadata:
      m_Items: []
  - m_Id: 2975284133269505
    m_Localized: "CINQ T\xCATES SE L\xC8VENT \xC0 LA LUEUR DE LA BOUGIE. LE COMPTE EST \xC0 SIX."
    m_Metadata:
      m_Items: []
  - m_Id: 2975284133269506
    m_Localized: "DOSSIERS CORROBOR\xC9S  \xB7  BANDE D'OBSERVATION EFFAC\xC9E ({habit})"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763192
  - m_Id: 2975284133269507
    m_Localized: "DOSSIERS CORROBOR\xC9S  \xB7  REGISTRE D'OBSERVATION SCELL\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 2975284133269508
    m_Localized: LES PORTES SONT OUVERTES MAINTENANT.
    m_Metadata:
      m_Items: []
  - m_Id: 2975284133269509
    m_Localized: "R\xC9ADMIS  \xB7  ADMISSION N\xB0 16"
    m_Metadata:
      m_Items: []
