  m_Name: Voices_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 142449efb3c77344abb64fc4d747b015, type: 2}
  m_Metadata:
    m_Items:
    - rid: 4707331672703763206
  m_TableData:
  - m_Id: 295604224
    m_Localized: nicht blinzeln.
    m_Metadata:
      m_Items: []
  - m_Id: 379490304
    m_Localized: da ist mein kleines licht.
    m_Metadata:
      m_Items: []
  - m_Id: 379490305
    m_Localized: lauf.
    m_Metadata:
      m_Items: []
  - m_Id: 379490306
    m_Localized: "du geh\xF6rst mir."
    m_Metadata:
      m_Items: []
  - m_Id: 379490307
    m_Localized: zu langsam.
    m_Metadata:
      m_Items: []
  - m_Id: 379490308
    m_Localized: ich rieche deine batterie.
    m_Metadata:
      m_Items: []
  - m_Id: 379490309
    m_Localized: hallo, dieb.
    m_Metadata:
      m_Items: []
  - m_Id: 379490310
    m_Localized: lauf schneller.
    m_Metadata:
      m_Items: []
  - m_Id: 379490311
    m_Localized: "deine beine sind m\xFCde."
    m_Metadata:
      m_Items: []
  - m_Id: 379490312
    m_Localized: "ich werde nicht m\xFCde."
    m_Metadata:
      m_Items: []
  - m_Id: 379490313
    m_Localized: "n\xE4her\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490314
    m_Localized: die sterne retten dich nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 379490315
    m_Localized: "lauf weiter. das gef\xE4llt mir."
    m_Metadata:
      m_Items: []
  - m_Id: 379490316
    m_Localized: du kannst dich nicht ewig verstecken.
    m_Metadata:
      m_Items: []
  - m_Id: 379490317
    m_Localized: ich finde dich.
    m_Metadata:
      m_Items: []
  - m_Id: 379490318
    m_Localized: ich kenne das labyrinth besser.
    m_Metadata:
      m_Items: []
  - m_Id: 379490319
    m_Localized: versteckst du dich? gut.
    m_Metadata:
      m_Items: []
  - m_Id: 379490320
    m_Localized: "wo bist du\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490321
    m_Localized: komm raus.
    m_Metadata:
      m_Items: []
  - m_Id: 379490322
    m_Localized: "ich h\xF6re dein herz."
    m_Metadata:
      m_Items: []
  - m_Id: 379490323
    m_Localized: "kleines licht, kleines licht\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490324
    m_Localized: "das dunkel geh\xF6rt mir."
    m_Metadata:
      m_Items: []
  - m_Id: 379490325
    m_Localized: "etage {floor}. die verl\xE4sst du nicht."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763206
  - m_Id: 379490326
    m_Localized: "\xDCBERRASCHUNG."
    m_Metadata:
      m_Items: []
  - m_Id: 379490327
    m_Localized: SO LANGE GEWARTET.
    m_Metadata:
      m_Items: []
  - m_Id: 379490328
    m_Localized: HIER ENTLANG? GUT.
    m_Metadata:
      m_Items: []
  - m_Id: 379490329
    m_Localized: HALLO.
    m_Metadata:
      m_Items: []
  - m_Id: 379490330
    m_Localized: ist da jemand drin?
    m_Metadata:
      m_Items: []
  - m_Id: 379490331
    m_Localized: ich rieche dich.
    m_Metadata:
      m_Items: []
  - m_Id: 379490332
    m_Localized: mach auf.
    m_Metadata:
      m_Items: []
  - m_Id: 379490333
    m_Localized: "einer von denen\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490334
    m_Localized: warmes metall.
    m_Metadata:
      m_Items: []
  - m_Id: 379490335
    m_Localized: "t\xFCren halten mich nicht auf."
    m_Metadata:
      m_Items: []
  - m_Id: 379490336
    m_Localized: lass mich rein.
    m_Metadata:
      m_Items: []
  - m_Id: 379490337
    m_Localized: klopf, klopf.
    m_Metadata:
      m_Items: []
  - m_Id: 379490338
    m_Localized: "keine t\xFCren mehr."
    m_Metadata:
      m_Items: []
  - m_Id: 379490339
    m_Localized: HAB DICH.
    m_Metadata:
      m_Items: []
  - m_Id: 379490340
    m_Localized: MEINS.
    m_Metadata:
      m_Items: []
  - m_Id: 379490341
    m_Localized: LIGHTS OUT.
    m_Metadata:
      m_Items: []
  - m_Id: 379490342
    m_Localized: GEFUNDEN.
    m_Metadata:
      m_Items: []
  - m_Id: 379490343
    m_Localized: da bist du ja.
    m_Metadata:
      m_Items: []
  - m_Id: 379490344
    m_Localized: ich seh dich.
    m_Metadata:
      m_Items: []
  - m_Id: 379490345
    m_Localized: gefunden.
    m_Metadata:
      m_Items: []
  - m_Id: 379490346
    m_Localized: hallo nochmal.
    m_Metadata:
      m_Items: []
  - m_Id: 379490347
    m_Localized: kuckuck.
    m_Metadata:
      m_Items: []
  - m_Id: 379490348
    m_Localized: lauf nicht weg. bitte lauf.
    m_Metadata:
      m_Items: []
  - m_Id: 379490349
    m_Localized: "du siehst m\xFCde aus."
    m_Metadata:
      m_Items: []
  - m_Id: 379490350
    m_Localized: ich hab gewartet.
    m_Metadata:
      m_Items: []
  - m_Id: 379490351
    m_Localized: zu hell.
    m_Metadata:
      m_Items: []
  - m_Id: 379490352
    m_Localized: du kannst es nicht ewig anlassen.
    m_Metadata:
      m_Items: []
  - m_Id: 379490353
    m_Localized: klick. klick.
    m_Metadata:
      m_Items: []
  - m_Id: 379490354
    m_Localized: blinzel.
    m_Metadata:
      m_Items: []
  - m_Id: 379490355
    m_Localized: ich warte.
    m_Metadata:
      m_Items: []
  - m_Id: 379490356
    m_Localized: deine batterie stirbt.
    m_Metadata:
      m_Items: []
  - m_Id: 379490357
    m_Localized: ochs am berg?
    m_Metadata:
      m_Items: []
  - m_Id: 379490358
    m_Localized: schau nicht weg.
    m_Metadata:
      m_Items: []
  - m_Id: 379490359
    m_Localized: bleib stehen.
    m_Metadata:
      m_Items: []
  - m_Id: 379490360
    m_Localized: "eins\u2026 zwei\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490361
    m_Localized: pssst.
    m_Metadata:
      m_Items: []
  - m_Id: 379490362
    m_Localized: lass dich ansehen.
    m_Metadata:
      m_Items: []
  - m_Id: 379490363
    m_Localized: "n\xE4her."
    m_Metadata:
      m_Items: []
  - m_Id: 379490364
    m_Localized: nicht bewegen.
    m_Metadata:
      m_Items: []
  - m_Id: 379490365
    m_Localized: BUH.
    m_Metadata:
      m_Items: []
  - m_Id: 379490366
    m_Localized: ERWISCHT!
    m_Metadata:
      m_Items: []
  - m_Id: 379490367
    m_Localized: "HAB DICH\u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 379490368
    m_Localized: MEINS.
    m_Metadata:
      m_Items: []
  - m_Id: 379490369
    m_Localized: JETZT.
    m_Metadata:
      m_Items: []
  - m_Id: 379490370
    m_Localized: abgeschlagen. du bist dran.
    m_Metadata:
      m_Items: []
  - m_Id: 379490371
    m_Localized: warm.
    m_Metadata:
      m_Items: []
  - m_Id: 379490372
    m_Localized: "er hat das geh\xF6rt."
    m_Metadata:
      m_Items: []
  - m_Id: 379490373
    m_Localized: ich hab ihm gesagt, wo du bist.
    m_Metadata:
      m_Items: []
  - m_Id: 379490374
    m_Localized: dein licht schmeckt gut.
    m_Metadata:
      m_Items: []
  - m_Id: 379490375
    m_Localized: wo bist du hin?
    m_Metadata:
      m_Items: []
  - m_Id: 379490376
    m_Localized: dann eben verstecken spielen.
    m_Metadata:
      m_Items: []
  - m_Id: 379490377
    m_Localized: "ich h\xF6r dich atmen."
    m_Metadata:
      m_Items: []
  - m_Id: 379490378
    m_Localized: "du kommst zur\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 379490379
    m_Localized: "ich komme\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490380
    m_Localized: klopf, klopf.
    m_Metadata:
      m_Items: []
  - m_Id: 379490381
    m_Localized: "ich wei\xDF, welcher."
    m_Metadata:
      m_Items: []
  - m_Id: 379490382
    m_Localized: eng da drin, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 379490383
    m_Localized: komm raus, komm raus.
    m_Metadata:
      m_Items: []
  - m_Id: 379490384
    m_Localized: ich kann die ganze nacht warten.
    m_Metadata:
      m_Items: []
  - m_Id: 379490385
    m_Localized: magst du das labyrinth?
    m_Metadata:
      m_Items: []
  - m_Id: 379490386
    m_Localized: "er ist n\xE4her als ich."
    m_Metadata:
      m_Items: []
  - m_Id: 379490387
    m_Localized: etage {floor}. nicht mehr viele.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763206
  - m_Id: 379490388
    m_Localized: dein herz ist laut.
    m_Metadata:
      m_Items: []
  - m_Id: 379490389
    m_Localized: "die sterne sind nicht f\xFCr dich."
    m_Metadata:
      m_Items: []
  - m_Id: 379490390
    m_Localized: geh weiter.
    m_Metadata:
      m_Items: []
  - m_Id: 379490391
    m_Localized: "Einundvierzig T\xFCren. Gestern vierzig."
    m_Metadata:
      m_Items: []
  - m_Id: 379490392
    m_Localized: Mach die neue nicht auf.
    m_Metadata:
      m_Items: []
  - m_Id: 379490393
    m_Localized: "Z\xE4hl mit mir. Eins..."
    m_Metadata:
      m_Items: []
  - m_Id: 379490394
    m_Localized: "Du hast meine Akte gelesen. Dann z\xE4hlst du auch."
    m_Metadata:
      m_Items: []
  - m_Id: 379490395
    m_Localized: Vierundvierzig. Es werden immer mehr.
    m_Metadata:
      m_Items: []
  - m_Id: 379490396
    m_Localized: "Noch eine T\xFCr. Deine."
    m_Metadata:
      m_Items: []
  - m_Id: 379490397
    m_Localized: Zweimal klopfen. Alles sicher.
    m_Metadata:
      m_Items: []
  - m_Id: 379490398
    m_Localized: "H\xF6r mal. H\xF6rst du sie gehen?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490399
    m_Localized: Die Rohre sind heute Nacht warm.
    m_Metadata:
      m_Items: []
  - m_Id: 379490400
    m_Localized: Da steht, ich antworte den Rohren. Die Rohre antworten mir.
    m_Metadata:
      m_Items: []
  - m_Id: 379490401
    m_Localized: Drei. Dreimal klopfen. Versteck dich.
    m_Metadata:
      m_Items: []
  - m_Id: 379490402
    m_Localized: "Es hat aufgeh\xF6rt zu klopfen. Warum hat es aufgeh\xF6rt?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490403
    m_Localized: "Die Schubladen sind kalt. Meine ist Nummer f\xFCnf."
    m_Metadata:
      m_Items: []
  - m_Id: 379490404
    m_Localized: "Ich laufe nachts. Ich wei\xDF nicht mehr, wohin."
    m_Metadata:
      m_Items: []
  - m_Id: 379490405
    m_Localized: "Du hast Schublade f\xFCnf gesehen. Stand mein Name drauf?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490406
    m_Localized: Morgen verlegen sie mich in die Chirurgie.
    m_Metadata:
      m_Items: []
  - m_Id: 379490407
    m_Localized: Danke, dass du runtergekommen bist.
    m_Metadata:
      m_Items: []
