  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Intake_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 5016db808c22b3a4aa58d1dcfcccca4a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 538873856
    m_Localized: LOOK AROUND
    m_Metadata:
      m_Items: []
  - m_Id: 631148544
    m_Localized: WALK TO THE MARKER
    m_Metadata:
      m_Items: []
  - m_Id: 631148545
    m_Localized: TURN ON YOUR TORCH
    m_Metadata:
      m_Items: []
  - m_Id: 631148546
    m_Localized: HOLD THE BEAM ON THE SIGN
    m_Metadata:
      m_Items: []
  - m_Id: 635342848
    m_Localized: TAKE THE BATTERY CELL
    m_Metadata:
      m_Items: []
  - m_Id: 635342849
    m_Localized: READ THE NOTE
    m_Metadata:
      m_Items: []
  - m_Id: 635342850
    m_Localized: CLOSE THE NOTE
    m_Metadata:
      m_Items: []
  - m_Id: 635342851
    m_Localized: PICK UP THE BOTTLE
    m_Metadata:
      m_Items: []
  - m_Id: 635342852
    m_Localized: THROW IT AT THE BELL
    m_Metadata:
      m_Items: []
  - m_Id: 635342853
    m_Localized: GO THROUGH THE SHUTTER
    m_Metadata:
      m_Items: []
  - m_Id: 635342854
    m_Localized: HIDE IN THE LOCKER
    m_Metadata:
      m_Items: []
  - m_Id: 635342855
    m_Localized: STAY STILL
    m_Metadata:
      m_Items: []
  - m_Id: 635342856
    m_Localized: IT IS GONE. LEAVE THE LOCKER
    m_Metadata:
      m_Items: []
  - m_Id: 635342857
    m_Localized: TAKE THE STAR
    m_Metadata:
      m_Items: []
  - m_Id: 635342858
    m_Localized: STEP ONTO THE HATCH
    m_Metadata:
      m_Items: []
  - m_Id: 635342861
    m_Localized: RIGHT THUMB
    m_Metadata:
      m_Items: []
  - m_Id: 635342862
    m_Localized: LEFT THUMB
    m_Metadata:
      m_Items: []
  - m_Id: 635342863
    m_Localized: TORCH
    m_Metadata:
      m_Items: []
  - m_Id: 635342864
    m_Localized: FOCUS
    m_Metadata:
      m_Items: []
  - m_Id: 635342865
    m_Localized: THROW
    m_Metadata:
      m_Items: []
  - m_Id: 635342866
    m_Localized: You wake. The bed is cold. Nobody is here.
    m_Metadata:
      m_Items: []
  - m_Id: 635342867
    m_Localized: Welcome back. You know the way - or skip it from the pause menu.
    m_Metadata:
      m_Items: []
  - m_Id: 635342868
    m_Localized: Get up.
    m_Metadata:
      m_Items: []
  - m_Id: 635342869
    m_Localized: The focused beam is narrower and reaches further. Hold it on the sign.
    m_Metadata:
      m_Items: []
  - m_Id: 635342870
    m_Localized: Your torch is fading. A battery cell tops it up.
    m_Metadata:
      m_Items: []
  - m_Id: 635342871
    m_Localized: Switched off, the torch slowly recharges - but never all the way.
    m_Metadata:
      m_Items: []
  - m_Id: 635342872
    m_Localized: The lamp sparks. The room goes dark.
    m_Metadata:
      m_Items: []
  - m_Id: 635342873
    m_Localized: The bell rings. Somewhere, a shutter rises.
    m_Metadata:
      m_Items: []
  - m_Id: 635342874
    m_Localized: Another bottle on the table.
    m_Metadata:
      m_Items: []
  - m_Id: 635342875
    m_Localized: Footsteps. Something heavy is being dragged.
    m_Metadata:
      m_Items: []
  - m_Id: 635342876
    m_Localized: Stars open the hatch. Down you go.
    m_Metadata:
      m_Items: []
  - m_Id: 635342877
    m_Localized: '"Stars open the hatch. The hatch is the way down. Something down there is hunting."'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
