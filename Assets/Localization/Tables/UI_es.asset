    m_Metadata:
      m_Items: []
  - m_Id: 1867415104778246
    m_Localized: CRUCETA ABAJO
    m_Metadata:
      m_Items: []
  - m_Id: 1867415104778247
    m_Localized: CRUCETA IZQ.
    m_Metadata:
      m_Items: []
  - m_Id: 1867415104778248
