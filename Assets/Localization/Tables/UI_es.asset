  - m_Id: 22165078315008
    m_Localized: VOLVER
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315009
    m_Localized: CONTINUAR
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315010
    m_Localized: Recoge. Escapa. Que no te vean.
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315011
    m_Localized: CONTINUAR
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315012
    m_Localized: EMPEZAR PARTIDA
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315013
    m_Localized: CONTROLES
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315014
    m_Localized: AJUSTES
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315015
    m_Localized: SALIR
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315016
    m_Localized: "\xBFEMPEZAR DE NUEVO?"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315017
    m_Localized: "Se perder\xE1 tu partida guardada (planta {floor})."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763212
  - m_Id: 22165078315018
    m_Localized: EMPEZAR DE NUEVO
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315019
    m_Localized: "C\xD3MO JUGAR"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315020
    m_Localized: <b>1.</b>   Recoge todas las estrellas ocultas en el laberinto.
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315021
    m_Localized: "<b>2.</b>   Se abrir\xE1 una trampilla en alg\xFAn lugar. Encu\xE9ntrala antes de que se acabe el tiempo."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315022
    m_Localized: "<b>3.</b>   No est\xE1s a solas aqu\xED abajo. Si te ve, <color=#DB1F17><b>corre</b></color>."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315023
    m_Localized: "<b>4.</b>   Los fragmentos brillan en la oscuridad. Entre plantas, alguien te vender\xE1 cosas a cambio."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315024
    m_Localized: EMPEZAR
    m_Metadata:
      m_Items: []
  - m_Id: 1867415029280768
    m_Localized: "RAT\xD3N"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315026
    m_Localized: '<b>PULGAR IZQ.</b>  moverse   <b>PULGAR DER.</b>  mirar   botones: <b>LINTERNA</b>, <b>ENFOCAR</b>, <b>INTERACTUAR</b>, <b>LANZAR</b>, <b>CORRER</b>'
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315027
    m_Localized: "Tu linterna tiene luz para tres minutos. Tus piernas, para menos. Los casilleros te esconden \u2014 a menos que te haya visto meterte."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315028
    m_Localized: PAUSA
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315029
    m_Localized: REANUDAR
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315030
    m_Localized: REINICIAR LABERINTO
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315031
    m_Localized: SALTAR TUTORIAL
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315032
    m_Localized: "MEN\xDA PRINCIPAL"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315033
    m_Localized: SALIR DEL JUEGO
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315034
    m_Localized: "READMISI\xD3N  \xB7  INGRESO {admission}  \xB7  PACIENTE {patient}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763212
  - m_Id: 22165078315035
    m_Localized: EL ESCRIBIENTE HA REGISTRADO TU REGRESO.
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315036
    m_Localized: "La trampilla se cerr\xF3 detr\xE1s de ti. Alguien ha dejado una luz encendida."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315037
    m_Localized: ya es tuyo
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315038
    m_Localized: sin pago
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315039
    m_Localized: PAGO  +{amount}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763212
  - m_Id: 22165078315040
    m_Localized: '{currency}  {shards}'
    m_Metadata:
      m_Items:
      - rid: 4707331672703763212
  - m_Id: 22165078315041
    m_Localized: "EFECTOS RETENIDOS EN LA TIENDA  \xB7  {shards} {currency}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763212
  - m_Id: 22165078315042
    m_Localized: CONTRATO  {name}  CUMPLIDO
    m_Metadata:
      m_Items:
      - rid: 4707331672703763212
  - m_Id: 22165078315043
    m_Localized: CONTRATO  {name}  FALLIDO
    m_Metadata:
      m_Items:
      - rid: 4707331672703763212
  - m_Id: 22165078315044
    m_Localized: CONTRATO  {name}  ANULADO
    m_Metadata:
      m_Items:
      - rid: 4707331672703763212
  - m_Id: 22165078315045
    m_Localized: "EST\xC1S FUERA"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315046
    m_Localized: PLANTA {floor} SUPERADA
    m_Metadata:
      m_Items:
      - rid: 4707331672703763212
  - m_Id: 22165078315047
    m_Localized: "La trampilla se cerr\xF3 detr\xE1s de ti. Ya no queda nada m\xE1s abajo."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315048
    m_Localized: "La trampilla se cerr\xF3 detr\xE1s de ti. Por alg\xFAn motivo, el camino hacia abajo lleva arriba."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315049
    m_Localized: "ESO TE ENCONTR\xD3"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315050
    m_Localized: Te vio esconderte.
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315051
    m_Localized: "Era m\xE1s r\xE1pido en la oscuridad."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315052
    m_Localized: "Nunca lo o\xEDste venir."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315053
    m_Localized: SIN TIEMPO
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315054
    m_Localized: "La trampilla se sell\xF3. Llevabas {stars} {stars:plural:estrella|estrellas} y estabas a {metres} {metres:plural:metro|metros}."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763212
  - m_Id: 22165078315055
    m_Localized: PLANTA {floor}     ESTRELLAS {collected} / {total}     TIEMPO {time}     SEMILLA {seed}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763212
  - m_Id: 22165078315056
    m_Localized: "CONSOLACI\xD3N  +{amount}     {currency}  {shards}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763212
  - m_Id: 22165078315057
    m_Localized: "SIN CONSOLACI\xD3N     {currency}  {shards}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763212
  - m_Id: 22165078315058
    m_Localized: "PAGO  +{amount}     TOTAL DE LA CAMPA\xD1A  {total}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763212
  - m_Id: 22165078315059
    m_Localized: SIGUIENTE PLANTA
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315060
