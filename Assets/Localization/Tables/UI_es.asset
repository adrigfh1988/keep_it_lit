    m_Localized: ADELANTE
    m_Metadata:
      m_Items: []
  - m_Id: 1867415108972553
    m_Localized: "ATR\xC1S"
    m_Metadata:
      m_Items: []
  - m_Id: 1867415108972554
    m_Localized: IZQUIERDA
    m_Metadata:
      m_Items: []
  - m_Id: 1867415108972555
    m_Localized: DERECHA
    m_Metadata:
      m_Items: []
  - m_Id: 1867415108972556
