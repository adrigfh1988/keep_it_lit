    - rid: 4707331789613957377
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Floor 2 (Tomas): two knocks in the pipes, which means all clear (it may lie; 2.5 s)'
    - rid: 4707331789613957378
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Floor 2: three knocks in the pipes, which means hide (it may lie; 2.5 s)'
    - rid: 4707331789613957379
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Floor 3 (Elias): an empty morgue drawer rolls out (pool .0-.2, 3 s, ALL CAPS)'
    - rid: 4707331789613957380
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Floor 3: an empty morgue drawer (pool)'
    - rid: 4707331789613957381
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Floor 3: an empty morgue drawer (pool)'
    - rid: 4707331789613957382
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
