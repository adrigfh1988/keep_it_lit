  m_TableData:
  - m_Id: 295604224
    m_Localized: ne cligne pas.
    m_Metadata:
      m_Items: []
  - m_Id: 379490304
    m_Localized: "voil\xE0 ma petite lumi\xE8re."
    m_Metadata:
      m_Items: []
  - m_Id: 379490305
    m_Localized: cours.
    m_Metadata:
      m_Items: []
  - m_Id: 379490306
    m_Localized: "tu es \xE0 moi."
    m_Metadata:
      m_Items: []
  - m_Id: 379490307
    m_Localized: pas assez vite.
    m_Metadata:
      m_Items: []
  - m_Id: 379490308
    m_Localized: je sens ta pile.
    m_Metadata:
      m_Items: []
  - m_Id: 379490309
    m_Localized: bonsoir, voleur.
    m_Metadata:
      m_Items: []
  - m_Id: 379490310
    m_Localized: cours plus vite.
    m_Metadata:
      m_Items: []
  - m_Id: 379490311
    m_Localized: tes jambes fatiguent.
    m_Metadata:
      m_Items: []
  - m_Id: 379490312
    m_Localized: moi, je ne fatigue pas.
    m_Metadata:
      m_Items: []
  - m_Id: 379490313
    m_Localized: "plus pr\xE8s\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490314
    m_Localized: "les \xE9toiles ne te sauveront pas."
    m_Metadata:
      m_Items: []
  - m_Id: 379490315
    m_Localized: "cours encore. j'aime \xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 379490316
    m_Localized: tu ne te cacheras pas toujours.
    m_Metadata:
      m_Items: []
  - m_Id: 379490317
    m_Localized: je te trouverai.
    m_Metadata:
      m_Items: []
  - m_Id: 379490318
    m_Localized: je connais mieux ce labyrinthe.
    m_Metadata:
      m_Items: []
  - m_Id: 379490319
    m_Localized: tu te caches? bien.
    m_Metadata:
      m_Items: []
  - m_Id: 379490320
    m_Localized: "o\xF9 es-tu\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490321
    m_Localized: sors.
    m_Metadata:
      m_Items: []
  - m_Id: 379490322
    m_Localized: "j'entends ton c\u0153ur."
    m_Metadata:
      m_Items: []
  - m_Id: 379490323
    m_Localized: "petite lumi\xE8re, petite lumi\xE8re\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490324
    m_Localized: "le noir est \xE0 moi."
    m_Metadata:
      m_Items: []
  - m_Id: 379490325
    m_Localized: "\xE9tage {floor}. tu n'en sortiras pas."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763207
  - m_Id: 379490326
    m_Localized: SURPRISE.
    m_Metadata:
      m_Items: []
  - m_Id: 379490327
    m_Localized: J'AI TANT ATTENDU.
    m_Metadata:
      m_Items: []
  - m_Id: 379490328
    m_Localized: PAR ICI? PARFAIT.
    m_Metadata:
      m_Items: []
  - m_Id: 379490329
    m_Localized: COUCOU.
    m_Metadata:
      m_Items: []
  - m_Id: 379490330
    m_Localized: "il y a quelqu'un l\xE0-dedans?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490331
    m_Localized: je te sens.
    m_Metadata:
      m_Items: []
  - m_Id: 379490332
    m_Localized: ouvre.
    m_Metadata:
      m_Items: []
  - m_Id: 379490333
    m_Localized: "l'un de ceux-l\xE0\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490334
    m_Localized: "m\xE9tal ti\xE8de."
    m_Metadata:
      m_Items: []
  - m_Id: 379490335
    m_Localized: "les portes ne m'arr\xEAtent pas."
    m_Metadata:
      m_Items: []
  - m_Id: 379490336
    m_Localized: laisse-moi entrer.
    m_Metadata:
      m_Items: []
  - m_Id: 379490337
    m_Localized: toc toc.
    m_Metadata:
      m_Items: []
  - m_Id: 379490338
    m_Localized: plus de portes.
    m_Metadata:
      m_Items: []
  - m_Id: 379490339
    m_Localized: JE TE TIENS.
    m_Metadata:
      m_Items: []
  - m_Id: 379490340
    m_Localized: "\xC0 MOI."
    m_Metadata:
      m_Items: []
  - m_Id: 379490341
    m_Localized: LIGHTS OUT.
    m_Metadata:
      m_Items: []
  - m_Id: 379490342
    m_Localized: "TE VOIL\xC0."
    m_Metadata:
      m_Items: []
  - m_Id: 379490343
    m_Localized: "te voil\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 379490344
    m_Localized: je te vois.
    m_Metadata:
      m_Items: []
  - m_Id: 379490345
    m_Localized: "je sais o\xF9 tu es."
    m_Metadata:
      m_Items: []
  - m_Id: 379490346
    m_Localized: rebonjour.
    m_Metadata:
      m_Items: []
  - m_Id: 379490347
    m_Localized: coucou.
    m_Metadata:
      m_Items: []
  - m_Id: 379490348
    m_Localized: "ne cours pas. cours, s'il te pla\xEEt."
    m_Metadata:
      m_Items: []
  - m_Id: 379490349
    m_Localized: "tu as l'air \xE0 bout."
    m_Metadata:
      m_Items: []
  - m_Id: 379490350
    m_Localized: je t'attendais.
    m_Metadata:
      m_Items: []
  - m_Id: 379490351
    m_Localized: trop clair.
    m_Metadata:
      m_Items: []
  - m_Id: 379490352
    m_Localized: "tu ne la garderas pas allum\xE9e pour toujours."
    m_Metadata:
      m_Items: []
  - m_Id: 379490353
    m_Localized: clic. clic.
    m_Metadata:
      m_Items: []
  - m_Id: 379490354
    m_Localized: cligne.
    m_Metadata:
      m_Items: []
  - m_Id: 379490355
    m_Localized: j'attendrai.
    m_Metadata:
      m_Items: []
  - m_Id: 379490356
    m_Localized: ta pile se meurt.
    m_Metadata:
      m_Items: []
  - m_Id: 379490357
    m_Localized: un, deux, trois, soleil?
    m_Metadata:
      m_Items: []
  - m_Id: 379490358
    m_Localized: "ne d\xE9tourne pas les yeux."
    m_Metadata:
      m_Items: []
  - m_Id: 379490359
    m_Localized: reste immobile.
    m_Metadata:
      m_Items: []
  - m_Id: 379490360
    m_Localized: "un\u2026 deux\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490361
    m_Localized: chhh.
    m_Metadata:
      m_Items: []
  - m_Id: 379490362
    m_Localized: laisse-moi te regarder.
    m_Metadata:
      m_Items: []
  - m_Id: 379490363
    m_Localized: "plus pr\xE8s."
    m_Metadata:
      m_Items: []
  - m_Id: 379490364
    m_Localized: ne bouge pas.
    m_Metadata:
      m_Items: []
  - m_Id: 379490365
    m_Localized: BOUH.
    m_Metadata:
      m_Items: []
  - m_Id: 379490366
    m_Localized: CHAT!
    m_Metadata:
      m_Items: []
  - m_Id: 379490367
    m_Localized: "JE TE TIENS\u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 379490368
    m_Localized: "\xC0 MOI."
    m_Metadata:
      m_Items: []
  - m_Id: 379490369
    m_Localized: MAINTENANT.
    m_Metadata:
      m_Items: []
  - m_Id: 379490370
    m_Localized: "touch\xE9. c'est toi le chat."
    m_Metadata:
      m_Items: []
  - m_Id: 379490371
    m_Localized: tout chaud.
    m_Metadata:
      m_Items: []
  - m_Id: 379490372
    m_Localized: il a entendu.
    m_Metadata:
      m_Items: []
  - m_Id: 379490373
    m_Localized: "je lui ai dit o\xF9 tu es."
    m_Metadata:
      m_Items: []
  - m_Id: 379490374
    m_Localized: "ta lumi\xE8re a bon go\xFBt."
    m_Metadata:
      m_Items: []
  - m_Id: 379490375
    m_Localized: "o\xF9 tu te caches?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490376
    m_Localized: cache-cache, alors.
    m_Metadata:
      m_Items: []
  - m_Id: 379490377
    m_Localized: je t'entends respirer.
    m_Metadata:
      m_Items: []
  - m_Id: 379490378
    m_Localized: tu reviendras.
    m_Metadata:
      m_Items: []
  - m_Id: 379490379
    m_Localized: "j'arrive\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 379490380
    m_Localized: toc toc.
    m_Metadata:
      m_Items: []
  - m_Id: 379490381
    m_Localized: je sais lequel.
    m_Metadata:
      m_Items: []
  - m_Id: 379490382
    m_Localized: "on est \xE0 l'\xE9troit l\xE0-dedans, hein?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490383
    m_Localized: "sors, sors de l\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 379490384
    m_Localized: je peux attendre toute la nuit.
    m_Metadata:
      m_Items: []
  - m_Id: 379490385
    m_Localized: tu aimes le labyrinthe?
    m_Metadata:
      m_Items: []
  - m_Id: 379490386
    m_Localized: "il est plus pr\xE8s que moi."
    m_Metadata:
      m_Items: []
  - m_Id: 379490387
    m_Localized: "\xE9tage {floor}. il n'en reste plus beaucoup."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763207
  - m_Id: 379490388
    m_Localized: "ton c\u0153ur fait du bruit."
    m_Metadata:
      m_Items: []
  - m_Id: 379490389
    m_Localized: "les \xE9toiles ne sont pas pour toi."
    m_Metadata:
      m_Items: []
  - m_Id: 379490390
    m_Localized: continue de marcher.
    m_Metadata:
      m_Items: []
  - m_Id: 379490391
    m_Localized: Quarante et une portes. Hier, quarante.
    m_Metadata:
      m_Items: []
  - m_Id: 379490392
    m_Localized: N'ouvrez pas la nouvelle.
    m_Metadata:
      m_Items: []
  - m_Id: 379490393
    m_Localized: Comptez avec moi. Un...
    m_Metadata:
      m_Items: []
  - m_Id: 379490394
    m_Localized: Vous avez lu mon dossier. Alors vous comptez aussi.
    m_Metadata:
      m_Items: []
  - m_Id: 379490395
    m_Localized: Quarante-quatre. Il en vient toujours d'autres.
    m_Metadata:
      m_Items: []
  - m_Id: 379490396
    m_Localized: "Encore une porte. La v\xF4tre."
    m_Metadata:
      m_Items: []
  - m_Id: 379490397
    m_Localized: "Deux coups. Rien \xE0 signaler."
    m_Metadata:
      m_Items: []
  - m_Id: 379490398
    m_Localized: "\xC9coutez. Vous les entendez marcher?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490399
    m_Localized: Les tuyaux sont chauds ce soir.
    m_Metadata:
      m_Items: []
  - m_Id: 379490400
    m_Localized: "On a \xE9crit que je r\xE9ponds aux tuyaux. Eux me r\xE9pondent."
    m_Metadata:
      m_Items: []
  - m_Id: 379490401
    m_Localized: Trois. Trois coups. Cachez-vous.
    m_Metadata:
      m_Items: []
  - m_Id: 379490402
    m_Localized: "\xC7a ne frappe plus. Pourquoi \xE7a s'est arr\xEAt\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490403
    m_Localized: Les tiroirs sont froids. Le mien, c'est le cinq.
    m_Metadata:
      m_Items: []
  - m_Id: 379490404
    m_Localized: "Je marche la nuit. Je ne sais plus o\xF9."
    m_Metadata:
      m_Items: []
  - m_Id: 379490405
    m_Localized: "Vous avez vu le tiroir cinq. Mon nom \xE9tait dessus?"
    m_Metadata:
      m_Items: []
  - m_Id: 379490406
    m_Localized: "On me transf\xE8re en Chirurgie demain."
    m_Metadata:
      m_Items: []
  - m_Id: 379490407
    m_Localized: Merci de descendre me voir.
    m_Metadata:
      m_Items: []
