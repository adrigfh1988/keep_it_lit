  - m_Id: 22165078315008
    m_Localized: "ZUR\xDCCK"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315009
    m_Localized: WEITER
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315010
    m_Localized: Sammeln. Entkommen. Nicht gesehen werden.
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315011
    m_Localized: WEITER
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315012
    m_Localized: SPIEL STARTEN
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315013
    m_Localized: STEUERUNG
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315014
    m_Localized: EINSTELLUNGEN
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315015
    m_Localized: BEENDEN
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315016
    m_Localized: NEU BEGINNEN?
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315017
    m_Localized: Dein gespeicherter Lauf (Etage {floor}) geht verloren.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763203
  - m_Id: 22165078315018
    m_Localized: NEU BEGINNEN
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315019
    m_Localized: SO WIRD GESPIELT
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315020
    m_Localized: <b>1.</b>   Sammle jeden Stern ein, der im Labyrinth versteckt ist.
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315021
    m_Localized: "<b>2.</b>   Irgendwo \xF6ffnet sich eine Luke. Finde sie, bevor die Zeit abl\xE4uft."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315022
    m_Localized: <b>3.</b>   Du bist hier unten nicht allein. Wenn es dich sieht, <color=#DB1F17><b>lauf</b></color>.
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315023
    m_Localized: "<b>4.</b>   Splitter glitzern im Dunkeln. Zwischen den Etagen verkauft dir jemand Dinge daf\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315024
    m_Localized: STARTEN
    m_Metadata:
      m_Items: []
  - m_Id: 1867415029280768
    m_Localized: MAUS
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315026
    m_Localized: '<b>LINKER DAUMEN</b>  bewegen   <b>RECHTER DAUMEN</b>  umsehen   Tasten: <b>LAMPE</b>, <b>FOKUS</b>, <b>INTERAGIEREN</b>, <b>WERFEN</b>, <b>SPRINTEN</b>'
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315027
    m_Localized: "Deine Lampe hat Licht f\xFCr drei Minuten. Deine Beine haben weniger. Spinde verstecken dich \u2014 au\xDFer es hat dich hineinklettern sehen."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315028
    m_Localized: PAUSE
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315029
    m_Localized: FORTSETZEN
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315030
    m_Localized: NEU STARTEN
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315031
    m_Localized: "\xDCBERSPRINGEN"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315032
    m_Localized: "HAUPTMEN\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315033
    m_Localized: BEENDEN
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315034
    m_Localized: "WIEDERAUFGENOMMEN  \xB7  AUFNAHME {admission}  \xB7  PATIENT {patient}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763203
  - m_Id: 22165078315035
    m_Localized: "DER SCHREIBER HAT DEINE R\xDCCKKEHR ABGETIPPT."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315036
    m_Localized: Die Luke hat sich hinter dir geschlossen. Jemand hat ein Licht angelassen.
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315037
    m_Localized: schon deins
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315038
    m_Localized: kein Lohn
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315039
    m_Localized: AUSZAHLUNG  +{amount}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763203
  - m_Id: 22165078315040
    m_Localized: '{currency}  {shards}'
    m_Metadata:
      m_Items:
      - rid: 4707331672703763203
  - m_Id: 22165078315041
    m_Localized: "EFFEKTEN IM LADEN VERWAHRT  \xB7  {shards} {currency}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763203
  - m_Id: 22165078315042
    m_Localized: AUFTRAG  {name}  ERLEDIGT
    m_Metadata:
      m_Items:
      - rid: 4707331672703763203
  - m_Id: 22165078315043
    m_Localized: AUFTRAG  {name}  GESCHEITERT
    m_Metadata:
      m_Items:
      - rid: 4707331672703763203
  - m_Id: 22165078315044
    m_Localized: AUFTRAG  {name}  ENTFALLEN
    m_Metadata:
      m_Items:
      - rid: 4707331672703763203
  - m_Id: 22165078315045
    m_Localized: DU BIST ENTKOMMEN
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315046
    m_Localized: ETAGE {floor} GESCHAFFT
    m_Metadata:
      m_Items:
      - rid: 4707331672703763203
  - m_Id: 22165078315047
    m_Localized: Die Luke hat sich hinter dir geschlossen. Darunter ist nichts mehr.
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315048
    m_Localized: "Die Luke hat sich hinter dir geschlossen. Irgendwie f\xFChrt der Weg nach unten wieder hinauf."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315049
    m_Localized: ES HAT DICH GEFUNDEN
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315050
    m_Localized: Es sah dir beim Verstecken zu.
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315051
    m_Localized: Im Dunkeln war es schneller.
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315052
    m_Localized: "Du hast es nie kommen h\xF6ren."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315053
    m_Localized: ZEIT ABGELAUFEN
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315054
    m_Localized: Die Luke ist versiegelt. Du hattest {stars} {stars:plural:Stern|Sterne} und warst {metres} {metres:plural:Meter|Meter} entfernt.
    m_Metadata:
      m_Items:
      - rid: 4707331672703763203
  - m_Id: 22165078315055
    m_Localized: ETAGE {floor}     STERNE {collected} / {total}     ZEIT {time}     SEED {seed}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763203
  - m_Id: 22165078315056
    m_Localized: TROSTPREIS  +{amount}     {currency}  {shards}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763203
  - m_Id: 22165078315057
    m_Localized: KEIN TROSTPREIS     {currency}  {shards}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763203
  - m_Id: 22165078315058
    m_Localized: AUSZAHLUNG  +{amount}     KAMPAGNEN-SUMME  {total}
