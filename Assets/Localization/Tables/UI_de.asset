    m_Metadata:
      m_Items: []
  - m_Id: 22165078315081
    m_Localized: "Optionale Arbeit f\xFCr die n\xE4chste Etage. Immer nur einer. Bezahlt wird bei der Abrechnung, wenn du sie schaffst."
