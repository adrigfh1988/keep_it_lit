  - m_Id: 1896792261652549
    m_Localized: ABGESCHWOREN
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652550
    m_Localized: PATIENTENAKTE
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652551
    m_Localized: AKTE
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652552
    m_Localized: FREISCHALTUNGEN
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652553
    m_Localized: KODEX
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652554
    m_Localized: HILFEN
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652555
    m_Localized: KEINE AUFNAHMEN VERZEICHNET
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652556
    m_Localized: BEGONNENE KAMPAGNEN
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652557
    m_Localized: BEENDETE KAMPAGNEN
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652558
    m_Localized: GESEHENE ENDEN
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652559
    m_Localized: "BESTER EID \xB7 ENTLASSEN"
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652560
    m_Localized: "BESTER EID \xB7 LIGHTS OUT"
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652561
    m_Localized: VERDIENTE SPLITTER
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652562
    m_Localized: TIEFSTER ABSTIEG
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652563
    m_Localized: BESTE ETAGEN
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652564
    m_Localized: ETAGE {floor}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763203
  - m_Id: 1896792261652565
    m_Localized: EID {rank}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763203
  - m_Id: 1896792261652566
    m_Localized: NEU
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652567
    m_Localized: FREIGESCHALTET
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652568
    m_Localized: Noch nicht begegnet.
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652569
    m_Localized: WAS ER GELERNT HAT
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652570
    m_Localized: "\xC4NDERUNGEN GELTEN F\xDCR DAS N\xC4CHSTE LABYRINTH."
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652571
    m_Localized: "JEDE AKTIVIERTE HILFE MARKIERT DIESE KAMPAGNE DAUERHAFT ALS UNTERST\xDCTZT."
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652572
    m_Localized: "KODEX UND AKTE IM PAUSEMEN\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652573
    m_Localized: SCHLIESSE EINE ETAGE AB
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652574
    m_Localized: "SET: PL\xDCNDERER"
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652575
    m_Localized: SCHLIESSE ETAGE 2 AB
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652576
    m_Localized: 'LADENKARTE: STETHOSKOP'
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652577
    m_Localized: SCHLIESSE ETAGE 4 AB
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652578
    m_Localized: 'AUFTRAG: UNGESEHEN'
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652579
    m_Localized: SCHLIESSE ETAGE 4 AB
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652580
    m_Localized: DIE EIDLEITER
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652581
    m_Localized: ERREICHE EIN ENDE
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652582
    m_Localized: 'LAMPENFARBE: KNOCHEN'
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652583
    m_Localized: ERREICHE EIN ENDE
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652584
    m_Localized: "SET: L\xC4UFER"
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652585
    m_Localized: BEENDE 2 KAMPAGNEN
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652586
    m_Localized: 'LADENKARTE: LAMPE DES ARCHIVARS'
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652587
    m_Localized: SIEH BEIDE ENDEN
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652588
    m_Localized: 'LADENKARTE: DYNAMO'
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652589
    m_Localized: VERDIENE INSGESAMT 1500 SPLITTER
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652590
    m_Localized: 'SET: KARTOGRAF'
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652591
    m_Localized: BEENDE 3 KAMPAGNEN
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652592
    m_Localized: "AUFTR\xC4GE: H\xC4NDE WEG, KNAPP GENUG"
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652593
    m_Localized: ERREICHE EINE NOTE S AUF EINER ETAGE
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652594
    m_Localized: 'LAMPENFARBE: EIDROT'
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652595
    m_Localized: ERREICHE EIN ENDE MIT EID-RANG 5
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652596
    m_Localized: "LAMPENFARBE: STATIONSGR\xDCN"
    m_Metadata:
      m_Items: []
  - m_Id: 1896792261652597
    m_Localized: BEGEGNE ALLEM IM KODEX
    m_Metadata:
      m_Items: []
  - m_Id: 1901735156641792
    m_Localized: "ZUR\xDCCK VON STATION A. EINE T\xDCR MEHR ALS GESTERN."
    m_Metadata:
      m_Items: []
  - m_Id: 1901735156641793
    m_Localized: "ZUR\xDCCK AUS DEM KESSELRAUM. ZWEIMAL KLOPFEN. ALLES RUHIG."
    m_Metadata:
      m_Items: []
  - m_Id: 1901735156641794
    m_Localized: "ZUR\xDCCK AUS DER K\xDCHLKAMMER. EIN FACH BLIEB OFFEN."
    m_Metadata:
      m_Items: []
  - m_Id: 1901735156641795
    m_Localized: "ZUR\xDCCK AUS DEM OPERATIONSSAAL. DOSIS NICHT VERMERKT."
    m_Metadata:
      m_Items: []
  - m_Id: 1901735156641796
    m_Localized: "Hilde hat heute Nacht eine T\xFCr mehr gez\xE4hlt. Es war deine."
    m_Metadata:
      m_Items: []
  - m_Id: 1901735156641797
    m_Localized: Dreimal Klopfen. Dann nichts.
    m_Metadata:
      m_Items: []
  - m_Id: 1901735156641798
    m_Localized: "Ein Fach ist bereit. Es tr\xE4gt deine Nummer."
    m_Metadata:
      m_Items: []
  - m_Id: 1901735156641799
    m_Localized: Raum 4 ist nicht mehr leer.
    m_Metadata:
      m_Items: []
  - m_Id: 1901735156641800
    m_Localized: Der Schreiber hat deine Akte fertig getippt.
    m_Metadata:
      m_Items: []
