  - m_Id: 193175966617616
    m_Localized: COURSE
    m_Metadata:
      m_Items: []
  - m_Id: 193175966617617
    m_Localized: GRAINE {seed}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 193175966617618
    m_Localized: "PLUS PROFOND ENREGISTR\xC9: NIVEAU -{n}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 193175966617619
    m_Localized: "LES \xC9TOILES VONT PLUS BAS QUE LA DERNI\xC8RE FOIS."
    m_Metadata:
      m_Items: []
  - m_Id: 193175966617620
    m_Localized: "PAS DE SORTIE AUTORIS\xC9E."
    m_Metadata:
      m_Items: []
  - m_Id: 200700661239808
    m_Localized: ENTENDU
    m_Metadata:
      m_Items: []
  - m_Id: 356483168374784
    m_Localized: "\xC7A A APPRIS"
    m_Metadata:
      m_Items: []
  - m_Id: 356483260649472
    m_Localized: "CE QUE \xC7A A APPRIS"
    m_Metadata:
      m_Items: []
  - m_Id: 356483260649473
    m_Localized: "\xC7A FOUILLE LES CASIERS ET ATTEND PLUS LONGTEMPS DEVANT"
    m_Metadata:
      m_Items: []
  - m_Id: 356483260649474
    m_Localized: "\xC7A IGNORE LES JETS R\xC9P\xC9T\xC9S ET PEUT VENIR VOUS CHERCHER"
    m_Metadata:
      m_Items: []
  - m_Id: 356483260649475
    m_Localized: "\xC7A VOIT PLUS LOIN QUAND VOTRE LAMPE EST \xC9TEINTE"
    m_Metadata:
      m_Items: []
  - m_Id: 356483260649476
    m_Localized: "\xC7A VOUS ENTEND COURIR DE PLUS LOIN"
    m_Metadata:
      m_Items: []
  - m_Id: 827458641104896
    m_Localized: "CR\xC9DITS"
    m_Metadata:
      m_Items: []
  - m_Id: 827458737573888
    m_Localized: "CR\xC9DITS"
    m_Metadata:
      m_Items: []
  - m_Id: 827458737573889
    m_Localized: MUSIQUE
    m_Metadata:
      m_Items: []
  - m_Id: 827458737573890
    m_Localized: SON
    m_Metadata:
      m_Items: []
  - m_Id: 827458737573891
    m_Localized: ART
    m_Metadata:
      m_Items: []
  - m_Id: 827458737573892
    m_Localized: PERSONNAGES ET ANIMATION
    m_Metadata:
      m_Items: []
  - m_Id: 827458737573893
    m_Localized: POLICES
    m_Metadata:
      m_Items: []
  - m_Id: 827458737573894
    m_Localized: UNITY
    m_Metadata:
      m_Items: []
  - m_Id: 1857900619755520
    m_Localized: "R\xC9DUIRE LES CLIGNOTEMENTS"
    m_Metadata:
      m_Items: []
  - m_Id: 1857900695252992
    m_Localized: "AVERTISSEMENT PHOTOSENSIBILIT\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 1857900695252993
    m_Localized: "Ce jeu contient des lumi\xE8res clignotantes, des obscurit\xE9s soudaines et des motifs susceptibles de provoquer des crises chez les personnes atteintes d'\xE9pilepsie photosensible. Si vous ou un membre de votre famille avez d\xE9j\xE0 fait une crise, consultez un m\xE9decin avant de jouer. Arr\xEAtez imm\xE9diatement si vous ressentez des vertiges, une vision floue, des tics oculaires ou musculaires, ou une d\xE9sorientation. Vous pouvez activer R\xC9DUIRE LES CLIGNOTEMENTS ici ou dans PARAM\xC8TRES > G\xC9N\xC9RAL \xE0 tout moment."
    m_Metadata:
      m_Items: []
  - m_Id: 1857900695252994
    m_Localized: "SAUVEGARDE NON CHARG\xC9E"
    m_Metadata:
      m_Items: []
  - m_Id: 1857900695252995
    m_Localized: "Votre partie sauvegard\xE9e a \xE9t\xE9 cr\xE9\xE9e par une version plus r\xE9cente du jeu. Elle a \xE9t\xE9 mise de c\xF4t\xE9, pas supprim\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 1857900695252996
    m_Localized: "Votre partie sauvegard\xE9e n'a pas pu \xEAtre lue et a \xE9t\xE9 mise de c\xF4t\xE9. Une nouvelle campagne va commencer."
    m_Metadata:
      m_Items: []
  - m_Id: 1867415104778240
