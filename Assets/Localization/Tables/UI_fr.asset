    m_Metadata:
      m_Items: []
  - m_Id: 22165078315086
    m_Localized: PRIME  {amount}  {currency}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 22165078315087
    m_Localized: Rien au tableau.
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315088
    m_Localized: "Contrat accept\xE9: {name}.  \xC9tage {floor}."
    m_Metadata:
