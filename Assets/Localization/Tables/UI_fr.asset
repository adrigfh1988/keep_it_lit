    m_Localized: MOYENNE
    m_Metadata:
      m_Items: []
  - m_Id: 1109299234
    m_Localized: "\xC9LEV\xC9E"
    m_Metadata:
      m_Items: []
  - m_Id: 1109299235
    m_Localized: NORMAL
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315008
    m_Localized: RETOUR
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315009
    m_Localized: CONTINUER
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315010
    m_Localized: "R\xE9coltez. Fuyez. Restez invisible."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315011
    m_Localized: CONTINUER
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315012
    m_Localized: NOUVELLE PARTIE
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315013
    m_Localized: COMMANDES
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315014
    m_Localized: "PARAM\xC8TRES"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315015
    m_Localized: QUITTER
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315016
    m_Localized: RECOMMENCER?
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315017
    m_Localized: "Votre partie sauvegard\xE9e (\xE9tage {floor}) sera perdue."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 22165078315018
    m_Localized: RECOMMENCER
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315019
    m_Localized: COMMENT JOUER
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315020
    m_Localized: "<b>1.</b>   Ramassez toutes les \xE9toiles cach\xE9es dans le labyrinthe."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315021
    m_Localized: "<b>2.</b>   Une trappe s'ouvrira quelque part. Trouvez-la avant la fin du compte \xE0 rebours."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315022
    m_Localized: "<b>3.</b>   Quelque chose d'autre r\xF4de ici. Si \xE7a vous voit, <color=#DB1F17><b>courez</b></color>."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315023
    m_Localized: "<b>4.</b>   Les \xE9clats brillent dans le noir. Entre les \xE9tages, quelqu'un vous vendra des choses en \xE9change."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315024
    m_Localized: COMMENCER
    m_Metadata:
      m_Items: []
  - m_Id: 1867415029280768
    m_Localized: SOURIS
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315026
    m_Localized: "<b>POUCE GAUCHE</b>  se d\xE9placer   <b>POUCE DROIT</b>  regarder   boutons: <b>LAMPE</b>, <b>FOCALISER</b>, <b>INTERAGIR</b>, <b>LANCER</b>, <b>SPRINTER</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315027
    m_Localized: "Votre lampe a trois minutes de lumi\xE8re. Vos jambes, moins. Les casiers vous cachent \u2014 sauf si \xE7a vous regardait y entrer."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315028
    m_Localized: PAUSE
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315029
    m_Localized: REPRENDRE
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315030
    m_Localized: REFAIRE LE LABYRINTHE
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315031
    m_Localized: PASSER LE TUTORIEL
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315032
    m_Localized: MENU PRINCIPAL
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315033
    m_Localized: QUITTER
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315034
    m_Localized: "R\xC9ADMISSION  \xB7  ENTR\xC9E {admission}  \xB7  PATIENT {patient}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 22165078315035
    m_Localized: "LE GREFFIER A TAP\xC9 VOTRE RETOUR."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315036
    m_Localized: "La trappe s'est referm\xE9e derri\xE8re vous. Quelqu'un a laiss\xE9 une lumi\xE8re allum\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315037
    m_Localized: "d\xE9j\xE0 \xE0 vous"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315038
    m_Localized: "non pay\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315039
    m_Localized: PAIEMENT  +{amount}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 22165078315040
    m_Localized: '{currency}  {shards}'
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 22165078315041
    m_Localized: "EFFETS EN D\xC9P\xD4T \xC0 LA BOUTIQUE  \xB7  {shards} {currency}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 22165078315042
    m_Localized: "CONTRAT  {name}  R\xC9USSI"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 22165078315043
    m_Localized: "CONTRAT  {name}  \xC9CHOU\xC9"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 22165078315044
    m_Localized: "CONTRAT  {name}  ANNUL\xC9"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 22165078315045
    m_Localized: "VOUS VOIL\xC0 DEHORS"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315046
    m_Localized: "\xC9TAGE {floor} TERMIN\xC9"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 22165078315047
    m_Localized: "La trappe s'est referm\xE9e derri\xE8re vous. Il n'y a plus rien en dessous."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315048
    m_Localized: "La trappe s'est referm\xE9e derri\xE8re vous. \xC9trangement, le chemin vers le bas ram\xE8ne en haut."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315049
    m_Localized: "\xC7A VOUS TIENT"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315050
    m_Localized: "\xC7a vous regardait vous cacher."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315051
    m_Localized: "\xC7a allait plus vite dans le noir."
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315052
    m_Localized: Vous ne l'avez jamais entendu venir.
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315053
    m_Localized: "TEMPS \xC9COUL\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315054
    m_Localized: "La trappe s'est scell\xE9e. Vous aviez {stars} {stars:plural:\xE9toile|\xE9toiles} et elle \xE9tait \xE0 {metres} {metres:plural:m\xE8tre|m\xE8tres}."
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 22165078315055
    m_Localized: "\xC9TAGE {floor}     \xC9TOILES {collected} / {total}     TEMPS {time}     GRAINE {seed}"
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 22165078315056
    m_Localized: CONSOLATION  +{amount}     {currency}  {shards}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 22165078315057
    m_Localized: PAS DE CONSOLATION     {currency}  {shards}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 22165078315058
    m_Localized: PAIEMENT  +{amount}     TOTAL DE LA CAMPAGNE  {total}
    m_Metadata:
      m_Items:
      - rid: 4707331672703763199
  - m_Id: 22165078315059
    m_Localized: "\xC9TAGE SUIVANT"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315060
    m_Localized: "REJOUER CET \xC9TAGE"
    m_Metadata:
      m_Items: []
  - m_Id: 22165078315061
